# Copy to native.ini, next to dw2003.exe. Every line is optional, and the
# launcher writes this file for you: you only need it to set things by hand.
#
# Asuka Link (v1.3.0) keeps only these as options. The port's mods and the rest
# of its graphics options are fixed at their best values (fast travel, Digilog,
# fast text, full EXP share, training without luck, BladeGarurumon, your own
# effects, sounds and scripts on; the map's objective off; 60 fps, vsync, true
# colour...); their old lines here are skipped.

# Where the game read from your disc is (the first run writes it); relative to
# the exe's folder
data = data

# 1: start in fullscreen (F11 or Alt+Enter switches while playing)
fullscreen = 0

# The window's size, in 320x240 steps (3 = 960x720). Unset: the biggest that
# fits the screen (4 = 1280x960 on a 1080p one)
#scale = 3

# 1-8: the game drawn on the graphics card (OpenGL 3.3) that many times
# finer than the PSX's 320x240. Unset: as the window's size, up to 4
#render_scale = 4

# 1: battles in 16:9, the 3D seeing a third wider; the fields stay 4:3. The
# window is 16:9 then
widescreen = 0

# 0: no gamepad vibration
rumble = 1

# The buttons' icons: ps1 (the game's own), ps3, ps4, ps5, xbox360, xboxone,
# xboxseries, switch, keyboard, or auto (the device used last)
icons = ps5
# Each button's keys (SDL's names, two at most) and gamepad button (SDL's:
# a b x y by place, leftshoulder, lefttrigger, leftstick, dpup, back, start...),
# or none; the in-game options' Controls and the launcher write them. The
# buttons: cross, circle, square, triangle, l1, r1, l2, r2, l3, r3, start,
# select, up, down, left, right
#keys_cross = Z, Space
#pad_cross = a

# The in-game options (fullscreen, window, resolution, widescreen battles,
# icons, vibration, buttons) open from the field's pause menu: Start, OPTIONS.

# --- The co-op ---

# 0: the co-op off. On by default: without other players it opens no socket
coop = 1

# The other players' game, host or host:port (27500 without). The launcher's
# room writes it, and the game follows its changes while you play
#coop_peers = 192.168.1.20, 100.64.1.2:27500

# This game's port (UDP), if 27500 is taken
#coop_port = 27500

# The EXP and the money a battle gives, times this (1-5). The launcher's
# Settings, Game tab
#exp_multiplier = 1
#money_multiplier = 1

# --- For developers ---

# 1: debug keys. F1 the developers' stage select (stages, sound test, test
# battles), F3 the sound test, F4 the vibration test, F2 the game state to
# game_<n>.bin, F5 / F9 save / load a state (saves/quick.state, this build only)
debug = 0

# Logs to the console, per subsystem: cd, snd, pad, mc, ovl, gpu or all
# (also the DW3_LOG environment variable)
log =
