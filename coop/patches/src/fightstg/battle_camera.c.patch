--- a/src/fightstg/battle_camera.c
+++ b/src/fightstg/battle_camera.c
@@ -141,6 +141,9 @@
     s32 fighter;
     FighterInfo *info;
     FighterInfoEnemy *enemy;
+#ifdef NATIVE
+    s32 mirror = 0;
+#endif
 
     /* the match depends on the do-while and its breaks, the early exit that
        the stages' event code uses too */
@@ -153,6 +156,17 @@
         if (fighter == 0) {
             break;
         }
+#ifdef NATIVE
+        /* the co-op's PvP battle: an enemy that is a partner (the other player's) has a partner's entry, its cameras
+           as a partner's */
+        if ((id & 0xF0) && native_coop_pvp() != NULL) {
+            FIGHTSTG_fighterCache.funcs.getInfo(fighter);
+            if (!FIGHTSTG_fighterCache.isEnemy) {
+                id &= ~0xF0;
+                mirror = 1;
+            }
+        }
+#endif
         if (!(id & 0xF0)) {
             info = FIGHTSTG_fighterCache.funcs.getInfo(fighter);
             FIGHTSTG_fighterView.vpx = info->camPos[camera].x;
@@ -162,6 +176,14 @@
             FIGHTSTG_fighterView.vry = -info->camRef[camera].y;
             FIGHTSTG_fighterView.vrz = -info->camRef[camera].z;
             FIGHTSTG_fighterView.proj = info->camProj[camera];
+#ifdef NATIVE
+            if (mirror) { /* a partner's camera on the enemy's side: turned half round */
+                FIGHTSTG_fighterView.vpx = -FIGHTSTG_fighterView.vpx;
+                FIGHTSTG_fighterView.vpz = -FIGHTSTG_fighterView.vpz;
+                FIGHTSTG_fighterView.vrx = -FIGHTSTG_fighterView.vrx;
+                FIGHTSTG_fighterView.vrz = -FIGHTSTG_fighterView.vrz;
+            }
+#endif
         } else {
             enemy = (FighterInfoEnemy *)FIGHTSTG_fighterCache.funcs.getInfo(fighter);
             FIGHTSTG_fighterView.vpx = enemy->camPos[camera].x;
@@ -200,6 +222,12 @@
             break;
         }
         FIGHTSTG_fighterCache.funcs.getInfo(fighter);
+#ifdef NATIVE
+        if (!FIGHTSTG_fighterCache.isEnemy) { /* a partner (the co-op's PvP) has no camera count: an enemy's usual 3 */
+            FIGHTSTG_getFighterView(task, 0, 2); /* 3 cameras: the last one's */
+            break;
+        }
+#endif
         FIGHTSTG_getFighterView(task, 0, ((FighterInfoEnemy *)FIGHTSTG_fighterCache.enemyInfo)->cameraCount - 1);
     } while (0);
     return &FIGHTSTG_fighterView;
