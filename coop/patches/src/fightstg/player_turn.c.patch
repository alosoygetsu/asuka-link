 #include "fightstg.h"
 
+#ifdef NATIVE
+/* DW3_COOP_AUTO=battle (tests): the PvP battle's commands picked by themselves, an attack or, every third, the
+   partner's own technique; after a knockout, the first partner standing */
+static s32 coopAutoFrames;
+static s32 coopAutoCount;
+
+static s32 coopAutoCommand(PlayerTurn *task) {
+    BattleFighter *fighter = &FIGHTSTG_battle.fighters[0][FIGHTSTG_battle.active[0]];
+    s32 member = GAME.funcs.getPartyMember(FIGHTSTG_battle.active[0]);
+    s32 tech;
+    s32 mp;
+
+    if (native_coop_pvp() == NULL || !native_coop_auto_battle()) {
+        return 0;
+    }
+    native_coop_auto_quiet();
+    if (++coopAutoFrames < 45) {
+        return 0;
+    }
+    coopAutoFrames = 0;
+    task->action = 0;
+    if (native_coop_pvp()->sent == 0) {
+        s16 slots[4];
+
+        if (GAME.funcs.getPartnerSlots(member, slots) > 0 && slots[0] >= 3) {
+            /* the first command changes form when the partner can: into its first slot's, or back to its own */
+            task->action = 2;
+            task->arg = member;
+            task->digimon = fighter->id == slots[0] ? DIGIMON_DATA[member].id : slots[0];
+            native_coop_note("PvP test: digivolving from %d into %d", fighter->id, task->digimon);
+            return 1;
+        }
+    }
+    if (native_coop_auto_battle() == 2 && native_coop_pvp()->sent >= 4) {
+        task->action = 1; /* DW3_COOP_AUTO=giveup: the fifth command gives up */
+        native_coop_note("PvP test: giving up");
+        return 1;
+    }
+    if ((++coopAutoCount % 3 == 0 || native_coop_auto_battle() == 3) && fighter->id == DIGIMON_DATA[member].id) {
+        tech = DIGIMON_DATA[member].skills[6] | 0x8000;
+        mp = FIGHTSTG_battleFuncs.getTechCost(0, tech);
+        if (fighter->mp >= mp) {
+            fighter->mp -= mp;
+            task->action = 4;
+            task->arg = tech & SKILL_ID;
+        }
+    }
+    return 1;
+}
+#endif
+
