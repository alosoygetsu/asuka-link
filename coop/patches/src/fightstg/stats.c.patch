+#ifdef NATIVE
+/* The PvP battle (fieldstg/field.c): the enemy side is the other player's party, whose stats are worked out as the
+   player's are, from its partners: the party and those partners swapped into GAME a moment (coopPvpSwap), the
+   fighter the enemy's (coopPvpSide) */
+typedef struct CoopTeam {
+    s32 party[3];
+    s32 ids[3];
+    Partner partners[3];
+} CoopTeam;
+
+static s32 coopPvpSide;
+
+static void coopPvpSwap(void) {
+    CoopTeam *team = (CoopTeam *)native_coop_pvp()->team;
+    u8 *a;
+    u8 *b;
+    u8 t;
+    s32 i;
+    s32 k;
+
+    for (i = 0; i < 3; i++) {
+        k = GAME.party[i];
+        GAME.party[i] = team->party[i];
+        team->party[i] = k;
+    }
+    for (i = 0; i < 3; i++) {
+        if (GAME.party[i] < 0 || GAME.party[i] >= PARTNER_COUNT) {
+            continue;
+        }
+        a = (u8 *)&GAME.partners[GAME.party[i]];
+        b = (u8 *)&team->partners[i];
+        for (k = 0; k < (s32)sizeof(Partner); k++) {
+            t = a[k];
+            a[k] = b[k];
+            b[k] = t;
+        }
+    }
+}
+
+/* the swap undone: the partners back first, by the party swapped in, then the party */
+static void coopPvpUnswap(void) {
+    CoopTeam *team = (CoopTeam *)native_coop_pvp()->team;
+    u8 *a;
+    u8 *b;
+    u8 t;
+    s32 i;
+    s32 k;
+
+    for (i = 0; i < 3; i++) {
+        if (GAME.party[i] < 0 || GAME.party[i] >= PARTNER_COUNT) {
+            continue;
+        }
+        a = (u8 *)&GAME.partners[GAME.party[i]];
+        b = (u8 *)&team->partners[i];
+        for (k = 0; k < (s32)sizeof(Partner); k++) {
+            t = a[k];
+            a[k] = b[k];
+            b[k] = t;
+        }
+    }
+    for (i = 0; i < 3; i++) {
+        k = GAME.party[i];
+        GAME.party[i] = team->party[i];
+        team->party[i] = k;
+    }
+}
+#endif
