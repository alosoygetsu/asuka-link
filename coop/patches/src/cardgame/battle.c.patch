+#ifdef NATIVE
+/* The other's turn (the computer's state 3): its card into play, its targets as it marked them, or its pass */
+static void coopDuelTakeTurn(CardBattle *battle, CardBattleItems *items) {
+    CoopDuelPlay m;
+    CardPile *pile = &battle->sides[1].pile;
+    CardPlay *play;
+    s32 i;
+    s32 card = -1;
+
+    if (!coopDuelTake(DUEL_PLAY, &m, sizeof m)) {
+        return;
+    }
+    if (!m.pass) {
+        for (i = 0; i < pile->handCount; i++) {
+            if (pile->hand[i] == m.card + 40) {
+                card = i;
+            }
+        }
+        if (card < 0) {
+            native_coop_note("Duel: out of step: card %d isn't in the other's hand here", m.card + 40);
+        }
+    }
+    if (card < 0) {
+        if (battle->record.playCount == 0) {
+            battle->record.turnState = 11;
+            battle->record.waitTime = 20;
+            battle->record.passes++;
+            SOUND.playSound(SOUND_MENU_OPEN);
+            items->screen->openPanelIcon(items->screen, 1);
+        } else {
+            battle->record.turnState = 12;
+        }
+        return;
+    }
+    for (i = 0; i < 40; i++) {
+        battle->effectStep.marked[i] = 0;
+    }
+    battle->effectStep.marked[card] = 1;
+    CARDGAME_takeFlaggedCard(battle, items);
+    play = &battle->record.plays[battle->record.playCount];
+    play->targetKind = m.targetKind;
+    play->mark = m.mark;
+    if (m.targetSide >= 0 && m.targetIndex < battle->players[m.targetSide ^ 1].slotCount) {
+        play->target = battle->players[m.targetSide ^ 1].slots[m.targetIndex].order; /* its side is the other here */
+    } else if (m.targetCard >= 0) {
+        play->target = m.targetCard < 40 ? m.targetCard + 40 : m.targetCard - 40; /* a card of a hand */
+    }
+    for (i = 0; i < 15; i++) { /* its slots 0-5 are 6-11 here, and the other way */
+        battle->effectStep.marked[i] = m.marked[i < 6 ? i + 6 : i < 12 ? i - 6 : i];
+    }
+    if (battle->record.passes != 0) {
+        SOUND.playSound(SOUND_MENU_OPEN);
+        items->screen->closePanelIcon(items->screen, 0);
+    }
+    battle->record.turnState = 9;
+}
+#endif
