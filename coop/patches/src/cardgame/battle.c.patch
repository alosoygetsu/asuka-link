+/* 1 if side 0 takes the round: the higher total; even totals go to side 1 (the computer), but in the co-op's card
+   duel side 1 is the other player, so each game would give it to the other: there the one who started has it */
+static s32 coopDuelRoundMine(CardBattle *battle) {
+    if (battle->sides[0].pile.hpTotal != battle->sides[1].pile.hpTotal) {
+        return battle->sides[0].pile.hpTotal > battle->sides[1].pile.hpTotal;
+    }
+#ifdef NATIVE
+    if (native_coop_duel() != NULL) {
+        return coopDuelCoins[0] < coopDuelCoins[1];
+    }
+#endif
+    return 0;
+}
