 #include "cardgame.h"
 
+#ifdef NATIVE
+/* ---- The co-op's card duel (fieldstg/field.c): both games play the same battle, each on its side 0, the other's
+   player on side 1. Each game owns its side: at the checkpoints (a phase's start, a turn's) it sends its side 0's pile
+   and takes the other's as side 1's, so whatever the computer's own rules did to side 1 (its draws, its reserve, its
+   hand) is the other's real pile again. The other's choices come in messages (in order) where the computer would
+   choose: the cards it puts out, the card it plays (or its pass), with its targets. ---- */
+enum { DUEL_DECK = 1, DUEL_SYNC, DUEL_PUT_OUT, DUEL_PLAY, DUEL_CHOICE };
+
+typedef struct CoopDuelDeck {
+    s16 deck[40];
+    u32 coin;
+} CoopDuelDeck;
+
+typedef struct CoopDuelPutOut {
+    u8 count;
+    u8 marked[10];
+    u8 pad;
+    s16 cards[10]; /* the sender's (0-39) */
+} CoopDuelPutOut;
+
+typedef struct CoopDuelPlay {
+    s16 pass;
+    s16 card; /* the sender's (0-39) */
+    u8 marked[15]; /* the sender's: slots 0-5 its own, 6-11 the other's, 12-14 the plays */
+    u8 targetKind;
+    u8 mark;
+    s8 targetSide; /* the slot played on: its side as the sender sees it, and its index; -1 none */
+    s8 targetIndex;
+    s8 targetCard; /* a card of a hand as the target (effect step 151): the sender's (0-79), else -1 */
+} CoopDuelPlay;
+
+typedef struct CoopDuelChoice {
+    s16 card; /* the card picked (steps 169-173): the sender's (0-79), else -1 */
+    s8 choice; /* the slot picked (step 174): 0-5 the sender's, 6-11 the other's */
+    u8 marked[12];
+    u8 pad;
+} CoopDuelChoice;
+
+static s32 coopDuelSent;
+static u32 coopDuelCoins[2]; /* this player's, the other's */
+static s32 coopDuelGate; /* a checkpoint's pile sent, the other's awaited */
+
+/* the next message, which must be of kind: 1 taken into data, 0 not here yet */
+static s32 coopDuelTake(s32 kind, void *data, s32 size) {
+    u8 buf[240];
+    s32 got;
+    s32 k;
+
+    got = native_coop_duel_take(&k, buf, sizeof buf);
+    if (got < 0) {
+        return 0;
+    }
+    if (k != kind) {
+        native_coop_note("Duel: out of step: message of kind %d where %d was due", k, kind);
+    }
+    memcpy(data, buf, size < got ? size : got);
+    return 1;
+}
+
+/* once this player chose its deck: it goes over with a coin (who starts), the other's comes as the opponent's, drawn
+   as a player's (no groups, no reserve); 1 once it's here */
+static s32 coopDuelDecks(CardBattle *battle) {
+    CoopDuelDeck mine;
+    CoopDuelDeck theirs;
+    s32 i;
+
+    if (!coopDuelSent) {
+        for (i = 0; i < 40; i++) {
+            mine.deck[i] = GAME.decks[battle->deckChoice].cards[0] != 0 ? GAME.decks[battle->deckChoice].cards[i] - 1
+                                                                        : CARDGAME_defaultDeck[i];
+        }
+        mine.coin = native_coop_coin() | 1;
+        coopDuelCoins[0] = mine.coin;
+        native_coop_duel_post(DUEL_DECK, &mine, sizeof mine);
+        coopDuelSent = 1;
+    }
+    if (!coopDuelTake(DUEL_DECK, &theirs, sizeof theirs)) {
+        return 0;
+    }
+    coopDuelCoins[1] = theirs.coin;
+    for (i = 0; i < 40; i++) {
+        battle->opponentDeck[i] = theirs.deck[i];
+        battle->opponentDraws[i].order = i;
+        battle->opponentDraws[i].group = 0;
+        battle->opponentPlans[i].kind = 1;
+        battle->opponentPlans[i].flagged = 0;
+        battle->opponentPlans[i].priority = i + 400;
+    }
+    native_coop_note("Card duel: the decks across, %s first", coopDuelCoins[0] < coopDuelCoins[1] ? "this player" : "the other");
+    return 1;
+}
+
+/* side 1 drawn as a player's: every card of its deck drawable, none held back */
+static void coopDuelFlatDraws(CardBattle *battle) {
+    s32 i;
+
+    for (i = 0; i < 40; i++) {
+        battle->opponentDraws[i].order = i;
+        battle->opponentDraws[i].group = 0;
+    }
+    battle->drawEnd = 40;
+    battle->reserveStart = 40;
+}
+
+/* a checkpoint: this side's pile goes, the other's comes as side 1's; 1 once it's in */
+static s32 coopDuelSync(CardBattle *battle) {
+    CardPile theirs;
+    CardPile *pile = &battle->sides[1].pile;
+    u8 panel = pile->side;
+    s32 i;
+
+    if (!coopDuelGate) {
+        native_coop_duel_post(DUEL_SYNC, &battle->sides[0].pile, sizeof(CardPile));
+        coopDuelGate = 1;
+    }
+    if (!coopDuelTake(DUEL_SYNC, &theirs, sizeof theirs)) {
+        return 0;
+    }
+    coopDuelGate = 0;
+    if (pile->apTotal != theirs.apTotal || pile->hpTotal != theirs.hpTotal || pile->handCount != theirs.handCount ||
+        pile->deckCount != theirs.deckCount) {
+        /* the other's side came out differently here: its pile is taken over, but the games had gone apart */
+        native_coop_note("Duel: the other's side was AP %d HP %d hand %d deck %d here, %d %d %d %d there", pile->apTotal,
+                         pile->hpTotal, pile->handCount, pile->deckCount, theirs.apTotal, theirs.hpTotal, theirs.handCount,
+                         theirs.deckCount);
+    }
+    *pile = theirs;
+    pile->side = panel;
+    for (i = 0; i < 40; i++) {
+        pile->deck[i] = theirs.deck[i] + 40; /* its cards are 0-39 there, 40-79 here */
+    }
+    for (i = 0; i < 10; i++) {
+        pile->hand[i] = theirs.hand[i] + 40;
+        pile->discards[i] = theirs.discards[i] + 40;
+    }
+    coopDuelFlatDraws(battle);
+    return 1;
+}
+
+/* the phases that start at a checkpoint */
+static s32 coopDuelCheckpoint(s32 phase) {
+    return phase == CARD_PHASE_DEAL || phase == CARD_PHASE_PUT_OUT || phase == CARD_PHASE_PLAYS_BEFORE ||
+           phase == CARD_PHASE_PLAYS_AFTER || phase == CARD_PHASE_END_ROUND;
+}
+
+/* step 154 done (this player's cards put out): which, to the other */
+void CARDGAME_coopDuelSendPutOut(CardBattle *battle) {
+    CoopDuelPutOut m;
+    s32 i;
+
+    memset(&m, 0, sizeof m);
+    for (i = 0; i < 10 && i < battle->sides[0].pile.handCount; i++) {
+        m.marked[i] = battle->effectStep.marked[i] != 0;
+        m.cards[i] = battle->sides[0].pile.hand[i];
+        m.count += m.marked[i];
+    }
+    native_coop_duel_post(DUEL_PUT_OUT, &m, sizeof m);
+}
+
+/* step 157 (the computer's cards put out): the other's, marked as the computer marks them; 1 once here */
+s32 CARDGAME_coopDuelTakePutOut(CardBattle *battle, CardScreen *screen) {
+    CoopDuelPutOut m;
+    CardPile *pile = &battle->sides[1].pile;
+    s32 i;
+    s32 j;
+
+    if (!coopDuelTake(DUEL_PUT_OUT, &m, sizeof m)) {
+        return 0;
+    }
+    /* by the cards, not their places: the hand may be sorted differently here */
+    for (i = 0; i < pile->handCount; i++) {
+        battle->effectStep.marked[i] = 0;
+    }
+    for (j = 0; j < 10; j++) {
+        if (m.marked[j] == 0) {
+            continue;
+        }
+        for (i = 0; i < pile->handCount; i++) {
+            if (pile->hand[i] == m.cards[j] + 40 && battle->effectStep.marked[i] == 0) {
+                break;
+            }
+        }
+        if (i == pile->handCount) {
+            native_coop_note("Duel: out of step: card %d isn't in the other's hand here", m.cards[j] + 40);
+            continue;
+        }
+        CARDGAME_addCardPoints(battle, screen, pile, 0, pile->hand[i]);
+        battle->effectStep.marked[i] = 1;
+        battle->effectStep.count++;
+    }
+    return 1;
+}
+
+/* tests (DW3_COOP_AUTO=duel): this player puts out what it can, as the computer would */
+void CARDGAME_coopDuelAutoPutOut(CardBattle *battle, CardScreen *screen) {
+    CardPile *pile = &battle->sides[0].pile;
+    s32 i;
+
+    battle->effectStep.count = 0;
+    for (i = 0; i < pile->handCount; i++) {
+        battle->effectStep.marked[i] = 0;
+        if (battle->effectStep.count < 6 && CARDGAME_canPlayCard(battle, pile->points, pile->hand[i])) {
+            CARDGAME_addCardPoints(battle, screen, pile, 0, pile->hand[i]);
+            battle->effectStep.marked[i] = 1;
+            battle->effectStep.count++;
+        }
+    }
+}
+
+/* the slot played on, as the sender sees it: its side and index */
+static void coopDuelTarget(CardBattle *battle, s32 order, s8 *side, s8 *index) {
+    s32 s;
+    s32 i;
+
+    *side = -1;
+    *index = -1;
+    for (s = 0; s < 2; s++) {
+        for (i = 0; i < battle->players[s].slotCount; i++) {
+            if (battle->players[s].slots[i].order == order) {
+                *side = (s8)s;
+                *index = (s8)i;
+            }
+        }
+    }
+}
+
+/* 1 if card is in either side's hand */
+static s32 coopDuelInHand(CardBattle *battle, s32 card) {
+    s32 s;
+    s32 i;
+
+    for (s = 0; s < 2; s++) {
+        for (i = 0; i < battle->sides[s].pile.handCount; i++) {
+            if (battle->sides[s].pile.hand[i] == card) {
+                return 1;
+            }
+        }
+    }
+    return 0;
+}
+
+/* this player's card goes into play (step 0x12) or it passes: to the other */
+static void coopDuelSendPlay(CardBattle *battle, s32 pass) {
+    CoopDuelPlay m;
+    CardPlay *play = &battle->record.plays[battle->record.playCount];
+    s32 i;
+
+    memset(&m, 0, sizeof m);
+    m.pass = (s16)pass;
+    m.targetSide = m.targetIndex = m.targetCard = -1;
+    if (!pass) {
+        m.card = play->card;
+        for (i = 0; i < 15; i++) {
+            m.marked[i] = battle->effectStep.marked[i] != 0;
+        }
+        m.targetKind = play->targetKind;
+        m.mark = (u8)play->mark;
+        coopDuelTarget(battle, play->target, &m.targetSide, &m.targetIndex);
+        if (m.targetSide < 0 && coopDuelInHand(battle, play->target)) {
+            m.targetCard = (s8)play->target;
+        }
+    }
+    native_coop_duel_post(DUEL_PLAY, &m, sizeof m);
+}
+
+/* a card as the other sees it: its side 0's are 40-79 here, and the other way */
+static s32 coopDuelMirror(s32 card) {
+    return card < 40 ? card + 40 : card - 40;
+}
+
+/* the card at effectStep.choice of the pile that effectStep.vars[4] picks (CARDGAME_setupCardChoice); -1 none */
+static s32 coopDuelPileCard(CardBattle *battle, s32 index) {
+    CardPile *pile;
+
+    if (index < 0 || index >= 40) {
+        return -1;
+    }
+    switch (battle->effectStep.vars[4]) {
+    case 5:
+        return index < battle->sides[0].pile.handCount ? battle->sides[0].pile.hand[index] : -1;
+    case 11:
+        return index < battle->sides[1].pile.handCount ? battle->sides[1].pile.hand[index] : -1;
+    case 7:
+    case 13:
+        pile = &battle->sides[battle->effectStep.vars[4] == 13].pile;
+        return index >= pile->deckTop ? pile->deck[index] : -1;
+    case 9:
+        return index < battle->sides[0].pile.discardCount ? battle->sides[0].pile.discards[index] : -1;
+    case 15:
+        return index < battle->sides[1].pile.discardCount ? battle->sides[1].pile.discards[index] : -1;
+    }
+    return -1;
+}
+
+/* this player's card's choice (effect steps 169-174, once made): to the other */
+void CARDGAME_coopDuelSendChoice(CardBattle *battle, s32 step) {
+    CoopDuelChoice m;
+    s32 i;
+
+    memset(&m, 0, sizeof m);
+    m.card = -1;
+    m.choice = -1;
+    if (step == 174) {
+        m.choice = (s8)battle->effectStep.choice;
+        for (i = 0; i < 12; i++) {
+            m.marked[i] = battle->effectStep.marked[i] != 0;
+        }
+    } else {
+        m.card = (s16)coopDuelPileCard(battle, battle->effectStep.choice);
+    }
+    native_coop_duel_post(DUEL_CHOICE, &m, sizeof m);
+}
+
+static CoopDuelChoice coopDuelChoice;
+
+/* the other's card's choice: 1 once here (kept for CARDGAME_coopDuelApplyChoice), 0 not yet */
+s32 CARDGAME_coopDuelTakeChoice(CardBattle *battle) {
+    return coopDuelTake(DUEL_CHOICE, &coopDuelChoice, sizeof coopDuelChoice);
+}
+
+/* the other's choice over the one the computer just made (the step's own): the same card found in the same pile
+   here, or the same slot from this side */
+void CARDGAME_coopDuelApplyChoice(CardBattle *battle, s32 step) {
+    CoopDuelChoice *m = &coopDuelChoice;
+    s32 i;
+
+    if (step == 174) {
+        if (m->choice >= 0 && m->choice < 12) {
+            battle->effectStep.choice = m->choice < 6 ? m->choice + 6 : m->choice - 6;
+        }
+        for (i = 0; i < 12; i++) {
+            battle->effectStep.marked[i] = m->marked[i < 6 ? i + 6 : i - 6];
+        }
+        return;
+    }
+    if (m->card < 0) {
+        native_coop_note("Duel: out of step: no card picked by the other at step %d", step);
+        return;
+    }
+    for (i = 0; i < 40; i++) {
+        if (coopDuelPileCard(battle, i) == coopDuelMirror(m->card)) {
+            if (battle->effectStep.vars[4] == 13) {
+                battle->effectStep.marked[battle->effectStep.choice] = 0; /* the computer's, as pickComputerDeckCard marks */
+                battle->effectStep.marked[i] = 1;
+            }
+            battle->effectStep.choice = i;
+            return;
+        }
+    }
+    native_coop_note("Duel: out of step: card %d (step %d) isn't in that pile here", coopDuelMirror(m->card), step);
+}
+#endif
