+static void STPLNMET_drawTeam(PartnerChoice *task) {
+    static CVECTOR NORMAL = {0x80, 0x80, 0x80, 0};
+    static CVECTOR TAKEN = {0x38, 0x38, 0x48, 0};
+    SpriteDrawer sprite;
+    PartnerAnim *anim;
+    s32 i;
+
+    initSpriteDrawer(&sprite);
+    if (GFX.funcs.getTime() - task->frameTime > 12) {
+        task->frameTime = GFX.funcs.getTime();
+        for (i = 0; i < TEAM_PARTNERS; i++) {
+            anim = &STPLNMET_funcs.anims[i];
+            STPLNMET_teamFrames[i]++;
+            if (STPLNMET_teamFrames[i] >= 8 || anim->frames[STPLNMET_teamFrames[i]] == -1) {
+                STPLNMET_teamFrames[i] = 0;
+            }
+        }
+    }
+    /* the picks, before the team's panel as the confirmation draws them: in front of it */
+    sprite.setLayerId(task->layer, task->depth);
+    sprite.setTexture(0x140, 0x100);
+    for (i = 0; i < STPLNMET_teamCount; i++) {
+        anim = &STPLNMET_funcs.anims[STPLNMET_teamPicks[i]];
+        sprite.draw(FILE_CACHE.getEntry(PLNMET_BANK), anim->frames[STPLNMET_teamFrames[STPLNMET_teamPicks[i]]], TEAM_PICK_X(i), TEAM_PICK_Y);
+    }
+    /* the name's panel and the team's, as the confirmation has them */
+    sprite.setTexture(0x280, 0x100);
+    sprite.setLayerId(task->layer, task->depth);
+    sprite.draw(FILE_CACHE.getEntry(PLNMET_MENU), 6, 0x37, 0x2F);
+    sprite.draw(FILE_CACHE.getEntry(PLNMET_MENU), 2, 0x37, 0x2F);
+    STPLNMET_lookPortrait(task->layer, task->depth - 1, 0x4A, 0x53, 5, 1, 0x3B, 0x32, 0x1E, 0x25); /* the look, not Junior */
+    sprite.setLayerId(task->layer, task->depth - 1);
+    sprite.draw(FILE_CACHE.getEntry(PLNMET_MENU), 10, 0x37, 0x59);
+    sprite.setLayerId(task->layer, task->depth);
+    sprite.draw(FILE_CACHE.getEntry(PLNMET_MENU), 9, 0x37, 0x59);
+    /* the row: smaller, the ones picked darker, each on a cell (lit under the cursor) */
+    sprite.setTexture(0x140, 0x100);
+    for (i = 0; i < TEAM_PARTNERS; i++) {
+        anim = &STPLNMET_funcs.anims[i];
+        sprite.setScale(ONE * 5 / 8, ONE * 5 / 8, ONE);
+        sprite.setPivot(TEAM_ROW_X(i), TEAM_ROW_Y);
+        sprite.setColor(STPLNMET_teamPlace(i) ? &TAKEN : &NORMAL);
+        sprite.draw(FILE_CACHE.getEntry(PLNMET_BANK), anim->frames[STPLNMET_teamFrames[i]], TEAM_ROW_X(i), TEAM_ROW_Y);
+        if (i == STPLNMET_teamCursor) {
+            STPLNMET_teamRect(task, 0, TEAM_ROW_X(i) - 7, TEAM_ROW_Y - 3, 0x22, 0x1E, 0x28, 0x38, 0x80);
+        } else {
+            STPLNMET_teamRect(task, 0, TEAM_ROW_X(i) - 7, TEAM_ROW_Y - 3, 0x22, 0x1E, 0x08, 0x10, 0x30);
+        }
+    }
+    sprite.setColor(&NORMAL);
+    sprite.setScale(ONE, ONE, ONE);
+    /* the description's box */
+    STPLNMET_teamRect(task, 0, 0x10, 0xC6, 0x120, 0x24, 0x08, 0x10, 0x30);
+    /* the cursor's frame */
+    if (STPLNMET_teamCursor < TEAM_PARTNERS) {
+        STPLNMET_teamFrame(task, TEAM_ROW_X(STPLNMET_teamCursor) - 7, TEAM_ROW_Y - 3, 0x22, 0x1E);
+    } else if (STPLNMET_teamCursor < TEAM_PARTNERS + 3) {
+        STPLNMET_teamFrame(task, TEAM_PICK_X(STPLNMET_teamCursor - TEAM_PARTNERS) - 8, 0x74, 0x34, 0x22);
+    } else {
+        STPLNMET_teamFrame(task, TEAM_ACCEPT_X - 4, TEAM_ACCEPT_Y - 3, 0x34, 0x12);
+    }
+}
+
+static void STPLNMET_teamConfirm(PartnerChoice *task) {
+    s32 i;
+
+    if (STPLNMET_teamCount < 3) {
+        SOUND.playSound(SOUND_MENU_CANCEL);
+        return;
+    }
+    SOUND.playSound(SOUND_MENU_CONFIRM);
+    task->choice = native_team_set(STPLNMET_teamPicks);
+    /* a game pack's team, in any order, is that pack: its own lobby scene */
+    for (i = 0; i < 3; i++) {
+        s32 *pack = STPLNMET_funcs.choices[i];
+
+        if (STPLNMET_teamPlace(pack[0]) && STPLNMET_teamPlace(pack[1]) && STPLNMET_teamPlace(pack[2])) {
+            task->choice = i;
+        }
+    }
+    task->substate = 100;
+}
+
+static void STPLNMET_runTeam(PartnerChoice *task, PartnerChoiceWindows *windows) {
+    s32 old = STPLNMET_teamCursor;
+    s32 *c = &STPLNMET_teamCursor;
+    s32 place;
+    s32 i;
+
+    if (PAD_PRESSED(PAD_LEFT) || PAD_REPEATED(PAD_LEFT)) {
+        if (*c > 0 && *c != TEAM_PARTNERS) {
+            (*c)--;
+        }
+    } else if (PAD_PRESSED(PAD_RIGHT) || PAD_REPEATED(PAD_RIGHT)) {
+        if (*c < TEAM_PARTNERS - 1 || (*c >= TEAM_PARTNERS && *c < TEAM_PARTNERS + 3)) {
+            (*c)++;
+        }
+    } else if (PAD_PRESSED(PAD_UP) && *c < TEAM_PARTNERS) {
+        *c = TEAM_PARTNERS + *c * 4 / TEAM_PARTNERS; /* the pick (or Accept) above */
+    } else if (PAD_PRESSED(PAD_DOWN) && *c >= TEAM_PARTNERS) {
+        *c = (*c - TEAM_PARTNERS) * TEAM_PARTNERS / 4 + 1; /* the partners below */
+    }
+    if (old != *c) {
+        SOUND.playSound(SOUND_MENU_MOVE);
+        STPLNMET_showTeam(task, windows);
+    }
+    if (PAD_PRESSED(PAD_CROSS)) {
+        if (*c == TEAM_PARTNERS + 3) {
+            STPLNMET_teamConfirm(task);
+            return;
+        }
+        place = *c < TEAM_PARTNERS ? STPLNMET_teamPlace(*c) : *c - TEAM_PARTNERS + 1;
+        if (*c >= TEAM_PARTNERS && place > STPLNMET_teamCount) {
+            SOUND.playSound(SOUND_MENU_CANCEL); /* an empty pick */
+        } else if (place != 0) { /* drop it: the ones after it move up */
+            for (i = place - 1; i < STPLNMET_teamCount - 1; i++) {
+                STPLNMET_teamPicks[i] = STPLNMET_teamPicks[i + 1];
+            }
+            STPLNMET_teamCount--;
+            SOUND.playSound(SOUND_MENU_CANCEL);
+        } else if (STPLNMET_teamCount < 3) {
+            STPLNMET_teamPicks[STPLNMET_teamCount++] = *c;
+            SOUND.playSound(SOUND_MENU_CONFIRM);
+            if (STPLNMET_teamCount == 3) {
+                *c = TEAM_PARTNERS + 3; /* on to Accept */
+            }
+        } else {
+            SOUND.playSound(SOUND_MENU_CANCEL); /* three already */
+        }
+        STPLNMET_showTeam(task, windows);
+        return;
+    }
+    if (PAD_PRESSED(PAD_START)) {
+        STPLNMET_teamConfirm(task);
+        return;
+    }
+    if (PAD_PRESSED(PAD_TRIANGLE)) {
+        SOUND.playSound(SOUND_MENU_CANCEL);
+        task->substate = 200;
+        task->choice = 0;
+    }
+}
