+static s32 exitOpen(const NativeExit *e) { /* its slot's conditions, as the field tests them */
+    return (e->conditions[0][0] == 0xFFFF || FLAGS_00.checkCondition(e->conditions[0][0], e->conditions[0][1]) != 0) &&
+           (e->conditions[1][0] == 0xFFFF || FLAGS_00.checkCondition(e->conditions[1][0], e->conditions[1][1]) != 0);
+}
+
+/* Whether the player could walk out now (after the port's v0.19.1): from the
+   field the menu was opened in (GAME.fieldMode), through ways out that are
+   open, to a field of another area or off the map. Not from where only an
+   event lets the player go (a room without doors, a dungeon the story has
+   shut), nor from off the map */
+#define MAP_FIRST 0x200
+#define MAP_LAST 0x2D6
+static s32 canWalkOut(void) {
+    u8 seen[MAP_LAST - MAP_FIRST + 1];
+    s16 todo[MAP_LAST - MAP_FIRST + 1];
+    const NativeExit *exits;
+    s32 home = GAME.fieldMode;
+    s32 count;
+    s32 done = 0;
+    s32 n = 0;
+    s32 i;
+
+    if (home < MAP_FIRST || home > MAP_LAST) {
+        return 0;
+    }
+    exits = native_exits(&count);
+    memset(seen, 0, sizeof seen);
+    seen[home - MAP_FIRST] = 1;
+    todo[n++] = home;
+    while (done < n) {
+        s32 from = todo[done++];
+
+        for (i = 0; i < count; i++) {
+            const NativeExit *e = &exits[i];
+
+            if (e->from != from || !exitOpen(e)) {
+                continue;
+            }
+            if (e->to < MAP_FIRST || e->to > MAP_LAST || STSTATUS_mapAreas[e->to & 0xFF] != STSTATUS_mapAreas[home & 0xFF]) {
+                return 1;
+            }
+            if (!seen[e->to - MAP_FIRST]) {
+                seen[e->to - MAP_FIRST] = 1;
+                todo[n++] = e->to;
+            }
+        }
+    }
+    return 0;
+}
