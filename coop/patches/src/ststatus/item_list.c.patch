+/* The chosen entry: its place, its title and kind, its record, its reward
+   and its text */
+/* Asuka Link's steps: an entry's (a story step's, or a side quest's by its item), how many, and the one to do: the
+   next after the last that holds (an item handed in stops holding, and a quest doesn't go back for it), n when all do */
+static s32 journalSteps(s32 entry, const JournalStep **out) {
+    const JournalSteps *list = entry >= 0 ? JOURNAL_STORY : JOURNAL_QUEST_STEPS;
+    s32 count = entry >= 0 ? (s32)(sizeof JOURNAL_STORY / sizeof JOURNAL_STORY[0])
+                           : (s32)(sizeof JOURNAL_QUEST_STEPS / sizeof JOURNAL_QUEST_STEPS[0]);
+    s32 key = entry >= 0 ? entry : SIDE_QUESTS[-1 - entry].item;
+    s32 i;
+
+    for (i = 0; i < count; i++) {
+        if (list[i].key == key) {
+            *out = &JOURNAL_STEPS[list[i].first];
+            return list[i].count;
+        }
+    }
+    return 0;
+}
+
+static s32 journalStepDone(const JournalStep *step) {
+    if ((step->code & 0xF000) == 0xF000) {
+        return GAME.progress > (step->code & 0xFFF);
+    }
+    return FLAGS_00.checkCondition(step->code, 1) == 1;
+}
+
+static s32 journalStepNow(const JournalStep *steps, s32 n) {
+    s32 now = 0;
+    s32 i;
+
+    for (i = 0; i < n; i++) {
+        if (journalStepDone(&steps[i])) {
+            now = i + 1;
+        }
+    }
+    return now;
+}
+
+/* "Step k of n", made in a one-string text file of the co-op's words and digits */
+static void *journalStepCount(s32 k, s32 n) {
+    static u32 file[16];
+    s32 *texts = (s32 *)native_coop_text(LANGUAGE);
+    u8 *out = (u8 *)&file[2];
+    u8 *end = (u8 *)&file[16] - 1;
+    s32 part[4];
+    s32 i;
+
+    part[0] = COOP_TEXT_JOURNAL; /* "Step " */
+    part[1] = -k;
+    part[2] = COOP_TEXT_JOURNAL + 1; /* " of " */
+    part[3] = -n;
+    for (i = 0; i < 4; i++) {
+        char digits[4];
+        s32 d = 0;
+        s32 v = -part[i];
+        const u8 *src;
+
+        if (part[i] > 0) {
+            for (src = (const u8 *)getString(texts, part[i]); *src != 0 && out < end; src++) {
+                *out++ = *src;
+            }
+            continue;
+        }
+        do {
+            digits[d++] = (char)(v % 10);
+            v /= 10;
+        } while (v != 0 && d < 3);
+        while (d > 0) {
+            for (src = (const u8 *)getString(texts, COOP_TEXT_JOURNAL + 2 + digits[--d]); *src != 0 && out < end; src++) {
+                *out++ = *src;
+            }
+        }
+    }
+    *out = 0;
+    file[0] = 1;
+    file[1] = 8;
+    return file;
+}
