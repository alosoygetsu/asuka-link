--- a/src/fieldstg/actor_control.c
+++ b/src/fieldstg/actor_control.c
@@ -857,6 +857,30 @@
 #define SET_FILE_OTHER 0x03CA0064
 #endif
 
+#ifdef NATIVE
+/* The player's model (character creator, platform/coop.c): a character of the field whose file has a set the player
+   wants, or the nearest one it has. Most characters have stand (1) and walk (4) only: what the player does beyond
+   that (running, stopping, searching, the gauge game, falling, climbing) takes one of those */
+static s32 coopModelSet(s32 animFile, s32 set) {
+    s16 *entry;
+    s32 want;
+    s32 pass;
+
+    for (pass = 0; pass < 3; pass++) {
+        want = pass == 0 ? set
+             : pass == 2 ? ACTOR_ANIM_STAND
+             : set == ACTOR_ANIM_RUN || (set >= 0x1A && set < 0x25) ? ACTOR_ANIM_WALK
+             : ACTOR_ANIM_STAND;
+        for (entry = FILE_CACHE.getEntry(animFile); entry[0] != 0; entry += 6) {
+            if (entry[0] == want) {
+                return want;
+            }
+        }
+    }
+    return set; /* not even standing: the file's first set, as the game does */
+}
+#endif
+
