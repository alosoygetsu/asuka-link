+#ifdef NATIVE
+/* The player's model (character creator, platform/coop.c): a character of the field whose file has a set the player
+   wants, or the nearest one it has. Most characters have stand (1) and walk (4) only: what the player does beyond
+   that (running, stopping, searching, the gauge game, falling, climbing) takes one of those */
+static s32 coopModelSet(s32 animFile, s32 set) {
+    s16 *entry;
+    s32 want;
+    s32 pass;
+
+    for (pass = 0; pass < 3; pass++) {
+        want = pass == 0 ? set
+             : pass == 2 ? ACTOR_ANIM_STAND
+             : set == ACTOR_ANIM_RUN || (set >= 0x1A && set < 0x25) ? ACTOR_ANIM_WALK
+             : ACTOR_ANIM_STAND;
+        for (entry = FILE_CACHE.getEntry(animFile); entry[0] != 0; entry += 6) {
+            if (entry[0] == want) {
+                return want;
+            }
+        }
+    }
+    return set; /* not even standing: the file's first set, as the game does */
+}
+#endif
+
+#ifdef NATIVE
+/* The sets a model lacks, made of its own drawings: each to Junpei's measure, frame for frame (his times, whether it
+   loops or ends, his rise and fall), so that what waits for an animation's end still gets it. The drawings: the
+   model's standing ones (COOP_SRC_STAND), walking (WALK), walking seen from the back, as climbing a wall shows
+   (BACK), or standing turned to the directions beside, looking around (LOOK) */
+enum { COOP_SRC_STAND, COOP_SRC_WALK, COOP_SRC_BACK, COOP_SRC_LOOK };
+#define COOP_SYNTH_FRAMES 24
+#define COOP_SYNTH_ACTORS 6 /* the player, the scenes' Junpei, 3 ghosts */
+
+typedef struct CoopSynth {
+    Actor *actor; /* whose, NULL free */
+    s32 active; /* the loaded set is made here: frames[dir] in place of setAnims */
+    s32 frames[5][COOP_SYNTH_FRAMES * 4 + 1];
+} CoopSynth;
+
+static CoopSynth coopSynth[COOP_SYNTH_ACTORS];
+
+static s32 coopRecipe(s32 set) {
+    switch (set) {
+    case ACTOR_ANIM_RUN:
+    case ACTOR_ANIM_DROP_OFF:
+    case ACTOR_ANIM_FALL_FAR:
+        return COOP_SRC_WALK;
+    case ACTOR_ANIM_SEARCH:
+        return COOP_SRC_LOOK;
+    case ACTOR_ANIM_CLIMB_UP:
+    case ACTOR_ANIM_CLIMB_DOWN:
+    case ACTOR_ANIM_GET_ON_WALL:
+    case ACTOR_ANIM_CLIMB_OFF_TOP:
+    case ACTOR_ANIM_GET_OVER_EDGE:
+    case ACTOR_ANIM_CLIMB_OFF_BOTTOM:
+    case ACTOR_ANIM_CLIMB:
+        return COOP_SRC_BACK;
+    default:
+        return COOP_SRC_STAND;
+    }
+}
+
+/* set's row (an s16 set, then its five directions' animations) in a character's file, or NULL */
+static s16 *coopFindSet(s32 animFile, s32 set) {
+    s16 *entry;
+
+    for (entry = FILE_CACHE.getEntry(animFile); entry[0] != 0; entry += 6) {
+        if (entry[0] == set) {
+            return entry;
+        }
+    }
+    return NULL;
+}
+
+/* Junpei's file of set, as FIELDSTG_animateActor picks it */
+static s32 coopJunpeiFile(s32 set) {
+    if (set < 8) {
+        return SET_FILE_0;
+    }
+    if (set == 8) {
+        return SET_FILE_8;
+    }
+    if (set < 0x16) {
+        return SET_FILE_OTHER;
+    }
+    if (set < 0x1A) {
+        return SET_FILE_16;
+    }
+    if (set < 0x25) {
+        return SET_FILE_1A;
+    }
+    return SET_FILE_OTHER;
+}
+
+static s32 coopFrameCount(s32 *frames) {
+    s32 n;
+
+    for (n = 0; n < COOP_SYNTH_FRAMES && frames[n * 4] != 0 && frames[n * 4] != -1; n++) {
+    }
+    return n;
+}
+
+/* Makes set for actor (the model's file is actor->animFile) when the model lacks it and Junpei has it: 1 then.
+   scene: the scenes' Junpei (character 1, his own file), whose poses mostly face the camera whatever the direction
+   (the model's front drawing then) and sit or lie lower (its drawing moved 8 pixels at most, not sunk) */
+static s32 coopSynthesize(Actor *actor, s32 set, s32 scene) {
+    s32 model = actor->animFile;
+    s32 modelFile = model & 0xFFFF0000;
+    s16 *junpei;
+    s16 *stand;
+    s16 *walk;
+    s16 *from;
+    s32 jFile;
+    s32 *jf;
+    s32 *jStand;
+    s32 *src;
+    s32 *out;
+    s32 recipe = coopRecipe(set);
+    s32 slot;
+    s32 spare = -1;
+    s32 d;
+    s32 i;
+    s32 n;
+    s32 count;
+    s32 look;
+    s32 baseY;
+    s32 rise;
+    s32 front;
+
+    for (slot = 0; slot < COOP_SYNTH_ACTORS && coopSynth[slot].actor != actor; slot++) {
+        if (spare < 0 && coopSynth[slot].actor == NULL) {
+            spare = slot;
+        }
+    }
+    if (slot == COOP_SYNTH_ACTORS) {
+        if (spare < 0) {
+            return 0;
+        }
+        slot = spare;
+        coopSynth[slot].actor = actor;
+    }
+    coopSynth[slot].active = 0;
+    jFile = scene ? FIELDSTG_fileEntries[1] : coopJunpeiFile(set);
+    if (coopFindSet(model, set) != NULL || (junpei = coopFindSet(jFile, set)) == NULL) {
+        return 0; /* the model's own, or one Junpei hasn't either */
+    }
+    stand = coopFindSet(model, ACTOR_ANIM_STAND);
+    if (stand == NULL) {
+        stand = FILE_CACHE.getEntry(model);
+    }
+    walk = coopFindSet(model, ACTOR_ANIM_WALK);
+    if (walk == NULL) {
+        walk = stand;
+    }
+    from = recipe == COOP_SRC_WALK || recipe == COOP_SRC_BACK ? walk : stand;
+    /* the same animation in the five directions: a pose that faces the camera */
+    front = scene && junpei[1] == junpei[2] && junpei[2] == junpei[3] && junpei[3] == junpei[4] && junpei[4] == junpei[5];
+    for (d = 0; d < 5; d++) {
+        jf = FILE_CACHE.getEntry((jFile & 0xFFFF0000) | (u16)junpei[d + 1]);
+        jStand = FILE_CACHE.getEntry((SET_FILE_0 & 0xFFFF0000) | (u16)coopFindSet(SET_FILE_0, ACTOR_ANIM_STAND)[d + 1]);
+        baseY = jStand[3]; /* Junpei standing: his rise and fall are from there */
+        out = coopSynth[slot].frames[d];
+        n = coopFrameCount(jf);
+        for (i = 0; i < n; i++) {
+            look = d;
+            if (recipe == COOP_SRC_LOOK) { /* turned to the side, back, to the other side, back */
+                look = (i & 1) == 0 ? d : (i & 2) == 0 ? d - 1 : d + 1;
+                look = look < 0 ? 1 : look > 4 ? 3 : look;
+            } else if (recipe == COOP_SRC_BACK) {
+                look = 4; /* north: the back */
+            } else if (front) {
+                look = 0; /* south: the front */
+            }
+            src = FILE_CACHE.getEntry(modelFile | (u16)from[look + 1]);
+            count = coopFrameCount(src);
+            if (count == 0) {
+                return 0;
+            }
+            src += (i % count) * 4;
+            out[i * 4] = jf[i * 4];         /* Junpei's time */
+            out[i * 4 + 1] = src[1];        /* the model's drawing */
+            out[i * 4 + 2] = src[2];
+            rise = jf[i * 4 + 3] - baseY; /* raised or lowered as Junpei */
+            if (scene) {
+                rise = rise < -8 ? -8 : rise > 8 ? 8 : rise;
+            }
+            out[i * 4 + 3] = src[3] + rise;
+        }
+        out[n * 4] = jf[n * 4]; /* 0 loops, -1 ends, as his */
+    }
+    coopSynth[slot].active = 1;
+    return 1;
+}
+
+/* actor's frames for direction dir: its made set's, or the file's */
+static s32 *coopFrames(Actor *actor, s32 dir) {
+    s32 slot;
+
+    for (slot = 0; slot < COOP_SYNTH_ACTORS; slot++) {
+        if (coopSynth[slot].actor == actor && coopSynth[slot].active) {
+            return coopSynth[slot].frames[dir];
+        }
+    }
+    return FILE_CACHE.getEntry(actor->setAnims[dir]);
+}
+
+/* A field's actors go with it: the slots too */
+void coopSynthReset(void) {
+    s32 slot;
+
+    for (slot = 0; slot < COOP_SYNTH_ACTORS; slot++) {
+        coopSynth[slot].actor = NULL;
+        coopSynth[slot].active = 0;
+    }
+}
+#endif
