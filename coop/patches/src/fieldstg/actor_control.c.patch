+#ifdef NATIVE
+/* The character creator (stplnmet/choice.c): the look picked in a new game, kept in the save's GAME.pad5, bytes
+   nothing reads (a card stays standard): [0] COOP_LOOK_MAGIC, [1] the model (COOP_LOOK_MODELS), [2] the tone.
+   It shows from GAME.progress 2, which the Login Room's talk with the Account Clerk sets (wstag225's
+   endEvent5) before the movie into the Digital World; DW3_PLAYER_MODEL (tests) overrides it */
+#define COOP_LOOK_MAGIC 0xC0
+static const s16 COOP_LOOK_MODELS[3] = {0, 0x31, 0x10}; /* Junior (Junpei), the boy, the girl */
+
+static s32 coopModel(void) {
+    if (native_player_model() != 0) {
+        return native_player_model();
+    }
+    if (GAME.pad5[0] == COOP_LOOK_MAGIC && GAME.progress >= 2 && GAME.pad5[1] < 3) {
+        return COOP_LOOK_MODELS[GAME.pad5[1]];
+    }
+    return 0;
+}
+
+/* the field's: each ghost's look (field.c) */
+extern s32 coopGhostModel[];
+extern s32 coopGhostTone[];
+
+static s32 coopGhost(Actor *actor) {
+    return actor->key1 == 0x7C02 || actor->key1 == 0x7D02 || actor->key1 == 0x7E02 ? (actor->key1 >> 8) - 0x7C : -1;
+}
+
+/* the model actor shows: the player's and the scenes' Junpei the look picked, a ghost its player's */
+static s32 coopActorModel(Actor *actor) {
+    s32 n = coopGhost(actor);
+
+    if (n >= 0) {
+        return coopGhostModel[n];
+    }
+    return actor->key1 == 2 || actor->key1 == 1 ? coopModel() : 0;
+}
+
+static s32 coopTone(void) {
+    if (native_player_tone() >= 0) {
+        return native_player_tone();
+    }
+    return GAME.pad5[0] == COOP_LOOK_MAGIC && GAME.progress >= 2 ? GAME.pad5[2] % NATIVE_TONES : 0;
+}
+
+/* The look sent to the other players (field.c): 1 when there's one (the creator's, from the movie on), its model and
+   tone */
+s32 coopPlayerLook(s32 *model, s32 *tone) {
+    s32 shown = native_player_model() != 0 || native_player_tone() >= 0 ||
+                (GAME.pad5[0] == COOP_LOOK_MAGIC && GAME.progress >= 2);
+
+    *model = shown ? coopModel() : 0;
+    *tone = shown ? coopTone() : 0;
+    return shown;
+}
+
+/* After a frame of the player's (or the scenes' Junpei, or a ghost's) is loaded: its CLUT again, from the frame's
+   TIM, turned to the tone; from the TIM, so a frame loaded twice isn't turned twice */
+static void coopToneFrame(Actor *actor, s32 tone) {
+    u32 *tim = FILE_CACHE.getEntry(actor->frame[0]);
+    u16 colors[16];
+
+    if (tone == 0 || tim[0] != 0x10 || (tim[1] & 8) == 0) {
+        return;
+    }
+    native_tone_clut(colors, (u16 *)&tim[5], tone); /* the CLUT block: size, x y, w h, its colours */
+    native_vram_clut(actor->image->clutX, actor->image->clutY, colors);
+}
