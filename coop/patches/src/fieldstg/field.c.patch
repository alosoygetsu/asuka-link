+#ifdef NATIVE
+/*
+ * Co-op (platform/coop.c, coop = 1 in native.ini): the other players, up to
+ * 3 (COOP_GHOSTS), each an actor that looks like the player and stands where
+ * that player is (coop_peers; without it, the local player's own state of a
+ * moment ago, to test alone).
+ *
+ * Their frames need a box in VRAM that nothing else of the field uses. Once
+ * the field has run a moment (its files and every actor's first frame
+ * loaded), a blank box is looked for in the player's texture page, away from
+ * the slots of the party and the map's characters, and else in another page
+ * right of the frame buffers. Each takes a copy of the player's CLUT under
+ * its frames, its colours turned so the players tell each other apart.
+ */
+#define COOP_GHOSTS 3
+/* the ghosts' characters: the player's look (2) under ids nothing looks for, other player n's 0x7C02 + n * 0x100
+   (actor_control.c's animateActor knows them) */
+#define COOP_GHOST_KEY1(n) (0x7C02 + (n) * 0x100)
+#define COOP_GHOST_KIND 0x10 /* not the player (0), a partner (2, 4, 8) nor a map character (1):
+                                nothing bumps into it or talks to it */
+#define COOP_SLOT_W 16 /* the box of a frame, in VRAM words: 64 pixels at 4 bits */
+#define COOP_SLOT_H 64
+#define COOP_WAIT 30 /* frames of the field before the ghosts are made */
+
+static Actor *coopGhost[COOP_GHOSTS];
+static ActorImage coopGhostImage[COOP_GHOSTS];
+static s32 coopWait;
+static s32 coopSeen[COOP_GHOSTS]; /* drawn on this map yet: coop.log says it once */
+/* each ghost's look (actor_control.c draws it): the model (Actor.key1, 0 Junpei) and tone, tone -1 none (Junior in
+   the player's colour) */
+s32 coopGhostModel[COOP_GHOSTS];
+s32 coopGhostTone[COOP_GHOSTS] = {-1, -1, -1};
+s32 coopPlayerLook(s32 *model, s32 *tone); /* actor_control.c: 1 when the player has the creator's look */
+static s32 coopTried;
+
+static void coopReserveSlot(s32 image) {
+    ActorImage *slot = &FIELDSTG_state.images.actors[image + 2];
+
+    native_coop_vram_reserve(slot->imageX, slot->imageY, COOP_SLOT_W, COOP_SLOT_H);
+    native_coop_vram_reserve(slot->clutX, slot->clutY, 16, 1);
+}
+
+void coopSynthReset(void); /* actor_control.c: the models' made sets */
+static void coopTradeReset(void); /* a new field: no trade */
+
+/* As the field starts: no ghosts yet, and no slots kept */
+static void coopFieldStart(void) {
+    s32 i;
+
+    coopSynthReset();
+    for (i = 0; i < COOP_GHOSTS; i++) {
+        coopGhost[i] = NULL;
+        coopSeen[i] = 0;
+        coopGhostModel[i] = 0;
+        coopGhostTone[i] = -1;
+    }
+    coopWait = 0;
+    coopTried = 0;
+    native_coop_vram_reset();
+    coopTradeReset();
+}
+
+/* Makes ghost n in a free place of the field's characters (FieldChildren.npcs): a task only runs as a child of one
+   that runs. The slots of the party and the map's characters are kept already (coopCreateGhosts) */
+static void coopCreateGhost(FieldChildren *children, Actor *player, s32 n) {
+    ActorImage *mine = player->image;
+    ActorImage *image = &coopGhostImage[n];
+    Point page;
+    s32 slot;
+    s32 x;
+    s32 y;
+
+    for (slot = 0; slot < 15 && children->npcs[slot] != NULL; slot++) {
+    }
+    if (slot == 15) {
+        native_coop_note("map %X has 15 characters already: player %d isn't shown here", GAME.funcs.getMode(), n + 2);
+        return;
+    }
+    /* the frames and, under them at a multiple of 16 as a CLUT's x must be, the CLUT: in the player's page, or in
+       another */
+    page.x = mine->x;
+    page.y = mine->y;
+    if (!native_coop_find_vram(mine->x, mine->y, COOP_SLOT_W * 2, COOP_SLOT_H + 1, &x, &y) &&
+        !native_coop_find_vram_any(COOP_SLOT_W * 2, COOP_SLOT_H + 1, &x, &y, &page.x, &page.y)) {
+        native_coop_note("map %X has no room in VRAM for player %d: not shown here", GAME.funcs.getMode(), n + 2);
+        native_coop_vram_dump(mine->x, mine->y);
+        return;
+    }
+    native_coop_vram_reserve(x, y, COOP_SLOT_W * 2, COOP_SLOT_H + 1);
+    native_coop_vram_mine(x, y, COOP_SLOT_W * 2, COOP_SLOT_H + 1);
+    *image = *mine;
+    image->x = page.x;
+    image->y = page.y;
+    image->clutX = (x + 15) & ~15;
+    image->clutY = y + COOP_SLOT_H;
+    native_coop_vram_copy(mine->clutX, mine->clutY, image->clutX, image->clutY, 16, 1);
+    native_coop_vram_tint(image->clutX, image->clutY, n);
+    image->imageX = x;
+    image->imageY = y;
+    image->u = (x - image->x) * 4;
+    image->v = y - image->y;
+    coopGhost[n] = children->npcs[slot] = FIELDSTG_createActor(FIELD_CHARACTER_PLAYER, COOP_GHOST_KIND, 0, NULL);
+    coopGhost[n]->key1 = COOP_GHOST_KEY1(n);
+    coopGhost[n]->image = image;
+    native_log("coop: mode %X: player %d's frames at VRAM (%d, %d), page (%d, %d)", GAME.funcs.getMode(), n + 2, x, y,
+               image->x, image->y);
+}
+
+static void coopCreateGhosts(FieldChildren *children, Actor *player) {
+    FieldActorEntry **list;
+    s32 i;
+    s32 n = native_coop_peer_slots();
+
+    if (n == 0) {
+        return;
+    }
+    if (player->key1 != FIELD_CHARACTER_PLAYER) {
+        native_coop_note("map %X: you are character %X here, the others aren't shown", GAME.funcs.getMode(), player->key1);
+        return;
+    }
+    native_coop_vram_reclaim(); /* the last map's players' boxes, when nothing came over them */
+    for (i = -2; i < 4; i++) {
+        coopReserveSlot(i);
+    }
+    for (list = FIELDSTG_state.actors; list != NULL && *list != NULL; list++) {
+        coopReserveSlot((*list)->image);
+        if (g_coop_debug) {
+            native_log("coop: map character %X at (%d, %d)", (*list)->id, (*list)->x, (*list)->y);
+        }
+    }
+    for (i = 0; i < n && i < COOP_GHOSTS; i++) {
+        coopCreateGhost(children, player, i);
+    }
+}
+
+/* --- The card trade, at a Guardromon: talking to one (native_coop_guard_key) offers it before his own talk; who
+   chose it waits, and two players waiting (each at any Guardromon) trade. Only spare cards go: the copies none of the
+   three decks needs (a card counts once in GAME.cards however many decks use it, so a deck that uses it n times keeps
+   n). Each side's state rides on its packets (native_coop_trade_out/in), whole, every frame; a trade is applied when
+   both sides have confirmed the same two offers (their hashes), once (its session), and from confirming on neither
+   side can go back. Both players stand still meanwhile (FIELDSTG_state.busy) --- */
+
+#ifndef ABS
+#define ABS(x) ((x) < 0 ? -(x) : (x))
+#endif
+#define COOP_CARDS 0x13D /* GAME.cards'; the album's are from 1 */
+#define COOP_TRADE_ROWS 5
+#define COOP_TRADE_MENU 10 /* coopTrade.phase: the Guardromon's choice, talk or trade */
+#define COOP_TRADE_WAIT (60 * 60 * 5) /* frames a wait for another player lasts */
+#define COOP_TRADE_LINGER 90 /* frames the last word (done, no) keeps going out once the window is shut */
+#define COOP_TRADE_SHOW 120 /* frames a message stays */
+#define COOP_TEXT_T(n) (COOP_TEXT_TRADE + (n))
+enum {
+    T_TITLE, T_YOURS, T_THEIRS, T_SPARE, T_NO_SPARE, T_WANTS, T_ACCEPT, T_LEAVE, T_WAITING, T_READY, T_CONFIRM,
+    T_DONE, T_CANCELLED, T_DECLINED, T_NO_ROOM, T_AMOUNT, T_CONFIRMED, T_NOTHING, T_FULL, T_CHANGE, T_WAIT_DOTS,
+    T_TALK, T_TRADE_OPTION, T_WAIT_OTHER, T_BATTLE_OPTION, T_PREPARING
+};
+
+static struct {
+    s32 phase; /* COOP_TRADE_* (this side), or COOP_TRADE_MENU */
+    s32 peer;
+    u32 session;
+    s32 frames; /* in the phase */
+    s32 froze; /* busy was set here */
+    u32 readyTheirs; /* their offer's hash when this side got ready */
+    s32 menu; /* the Guardromon's choice: 0 talk, 1 trade, 2 battle */
+    s32 kind; /* what the wait is for: 0 a card trade, 1 a PvP battle (NativeCoopTrade.pad[0]) */
+    s32 teamSent;
+    Actor *talker; /* who talked to him, and where: his own talk, if that's the choice */
+    Point talkAt;
+    s32 passing; /* his own talk going on: not offered again */
+    s32 quiet; /* frames after a trade shuts: the press that shut it doesn't talk to him again */
+    NativeCoopTrade last; /* the last word, going out a while after */
+    s32 linger;
+    s32 msg, msgPeer, msgFrames; /* a message after the window: T_*, whose name, frames left */
+    s32 cursor, top, count; /* the spare cards' list */
+    s16 list[COOP_CARDS];
+    u8 spare[COOP_CARDS];
+    u8 offered[COOP_CARDS];
+    s32 note; /* a line under the list: T_NO_ROOM, T_FULL, -1 none */
+} coopTrade = {COOP_TRADE_NONE, -1};
+
+/* The spare copies of each card, and the list of the ones there are */
+static void coopTradeList(void) {
+    u8 use[COOP_CARDS];
+    u8 most[COOP_CARDS];
+    s32 d;
+    s32 i;
+    s32 c;
+
+    for (c = 0; c < COOP_CARDS; c++) {
+        most[c] = 0;
+    }
+    for (d = 0; d < DECK_COUNT; d++) {
+        for (c = 0; c < COOP_CARDS; c++) {
+            use[c] = 0;
+        }
+        for (i = 0; i < DECK_SIZE; i++) {
+            c = GAME.decks[d].cards[i];
+            if (c >= 0 && c < COOP_CARDS && ++use[c] > most[c]) {
+                most[c] = use[c];
+            }
+        }
+    }
+    coopTrade.count = 0;
+    for (c = 0; c < COOP_CARDS; c++) {
+        if (c == 0) { /* not a card */
+            coopTrade.spare[c] = coopTrade.offered[c] = 0;
+            continue;
+        }
+        coopTrade.spare[c] = GAME.cards[c] > most[c] ? GAME.cards[c] - most[c] : 0;
+        if (coopTrade.offered[c] > coopTrade.spare[c]) {
+            coopTrade.offered[c] = coopTrade.spare[c];
+        }
+        if (coopTrade.spare[c] != 0) {
+            coopTrade.list[coopTrade.count++] = c;
+        }
+    }
+    if (coopTrade.cursor >= coopTrade.count) {
+        coopTrade.cursor = coopTrade.count > 0 ? coopTrade.count - 1 : 0;
+    }
+}
+
+static u32 coopTradeHash(const NativeCoopTrade *t) {
+    u32 h = 0x811C9DC5u ^ t->count;
+    s32 i;
+
+    for (i = 0; i < t->count && i < COOP_TRADE_KINDS; i++) {
+        h = (h ^ t->card[i]) * 0x01000193u;
+        h = (h ^ t->copies[i]) * 0x01000193u;
+    }
+    return h | 1;
+}
+
+/* This side's offer, as it goes out */
+static void coopTradeOffer(NativeCoopTrade *t) {
+    s32 c;
+
+    t->count = 0;
+    for (c = 0; c < COOP_CARDS && t->count < COOP_TRADE_KINDS; c++) {
+        if (coopTrade.offered[c] != 0) {
+            t->card[t->count] = c;
+            t->copies[t->count++] = coopTrade.offered[c];
+        }
+    }
+    t->offer = coopTradeHash(t);
+}
+
+static s32 coopTradeKinds(void) {
+    s32 c;
+    s32 n = 0;
+
+    for (c = 0; c < COOP_CARDS; c++) {
+        n += coopTrade.offered[c] != 0;
+    }
+    return n;
+}
+
+/* Whether all of their offer fits (9 copies of a card at most) */
+static s32 coopTradeRoom(const NativeCoopTrade *in) {
+    s32 i;
+
+    for (i = 0; i < in->count; i++) {
+        if (in->card[i] == 0 || in->card[i] >= COOP_CARDS || GAME.cards[in->card[i]] + in->copies[i] > CARD_COPIES_MAX) {
+            return 0;
+        }
+    }
+    return 1;
+}
+
+/* Player n is in a field now (anywhere): its state, else 0 */
+static s32 coopTradePeer(s32 n, NativeCoopState *st) {
+    return n >= 0 && n < COOP_GHOSTS && native_coop_peer(n, st);
+}
+
+static s32 coopTradeFree(void) {
+    return FIELDSTG_state.busy == 0 && FIELDSTG_state.acting == 0 && FIELDSTG_state.innOpen == 0 &&
+           FIELDSTG_state.battleStarting == 0;
+}
+
+static void coopTradeFreeze(void) {
+    Actor *player = TASK_REGISTRY.funcs.find(FIELD_TASK_ACTOR, FIELD_CHARACTER_PLAYER, -1);
+
+    if (FIELDSTG_state.busy == 0) {
+        FIELDSTG_state.busy = 1;
+        coopTrade.froze = 1;
+    }
+    if (player != NULL && player->key1 == FIELD_CHARACTER_PLAYER) {
+        player->setSubstate(player, ACTOR_STAND);
+    }
+}
+
+/* The window shut: last says what goes out a while longer, msg (T_*, -1 none) what this side reads */
+static void coopTradeEnd(s32 lastPhase, s32 msg) {
+    s32 c;
+
+    coopTrade.last.session = coopTrade.session;
+    coopTrade.last.phase = lastPhase;
+    coopTrade.last.count = 0;
+    coopTrade.linger = lastPhase != COOP_TRADE_NONE ? COOP_TRADE_LINGER : 0;
+    coopTrade.msg = msg;
+    coopTrade.msgPeer = coopTrade.peer;
+    coopTrade.msgFrames = msg >= 0 ? COOP_TRADE_SHOW : 0;
+    if (coopTrade.froze) {
+        FIELDSTG_state.busy = 0;
+        coopTrade.froze = 0;
+    }
+    coopTrade.quiet = 20;
+    coopTrade.phase = COOP_TRADE_NONE;
+    for (c = 0; c < COOP_CARDS; c++) {
+        coopTrade.offered[c] = 0;
+    }
+}
+
+static void coopTradeReset(void) {
+    s32 c;
+
+    coopTrade.phase = COOP_TRADE_NONE;
+    coopTrade.froze = 0; /* the new field isn't busy */
+    coopTrade.linger = 0;
+    coopTrade.msgFrames = 0;
+    for (c = 0; c < COOP_CARDS; c++) {
+        coopTrade.offered[c] = 0;
+    }
+}
+
+static void coopTradeStart(s32 peer, u32 session, s32 phase) {
+    coopTrade.peer = peer;
+    coopTrade.session = session;
+    coopTrade.phase = phase;
+    coopTrade.frames = 0;
+    coopTrade.cursor = 0;
+    coopTrade.top = 0;
+    coopTrade.note = -1;
+    coopTrade.linger = 0;
+    coopTrade.msgFrames = 0;
+    coopTradeList();
+    coopTradeFreeze();
+}
+
+/* The talk button (FIELDSTG_talkToActorAt, target what stands at pos, the tile ahead): a Guardromon, with co-op on,
+   first offers the card trade. 1 when this took the talk */
+s32 coopTradeTalk(Actor *actor, Point *pos, Actor *target) {
+    if (g_coop_debug) {
+        native_log("coop: talk at (%d, %d), you at (%d, %d): character %X", pos->x, pos->y, actor->tile.x, actor->tile.y,
+                   target != NULL ? target->key1 : -1);
+    }
+    if (!g_coop || coopTrade.passing || target == NULL || target->key1 != native_coop_guard_key() ||
+        native_coop_peer_slots() == 0) {
+        return 0;
+    }
+    if (coopTrade.phase != COOP_TRADE_NONE || coopTrade.quiet > 0 || coopTrade.msgFrames > 0) {
+        return 1; /* a trade just shut (its last press, its message): no talk with him yet */
+    }
+    coopTradeStart(-1, 0, COOP_TRADE_MENU);
+    coopTrade.menu = 0;
+    coopTrade.talker = actor;
+    coopTrade.talkAt = *pos;
+    SOUND.playSound(SOUND_MENU_OPEN);
+    return 1;
+}
+
+/* ---- drawing: the game's own glyphs (as its text windows draw them) and panels, on the field's text layer: the
+   glyphs at its depth 0, the panels behind at 1 ---- */
+
+static void coopTradeRect(s32 x, s32 y, s32 w, s32 h, s32 r, s32 g, s32 b, s32 half) {
+    Layer *layer = GFX.funcs.getLayer(FIELD_LAYER_TEXT);
+    u_long *ot = (u_long *)layer->getOtEntry(layer, 1);
+    POLY_F4 *poly = GFX.funcs.getPrim();
+    DR_TPAGE *mode;
+
+    setPolyF4(poly);
+    setRGB0(poly, r, g, b);
+    setXY4(poly, x, y, x + w, y, x, y + h, x + w, y + h);
+    if (half) {
+        setSemiTrans(poly, 1);
+    }
+    addPrim(ot, poly);
+    mode = (DR_TPAGE *)(poly + 1);
+    if (half) { /* drawn first: the ground under it darkened (subtracted) */
+        SetDrawTPage(mode, 0, 1, GetTPage(0, 2, 0, 0));
+        addPrim(ot, mode);
+        mode++;
+    }
+    GFX.funcs.setPrim(mode);
+}
+
+/* A panel: a gold frame, then (behind it, as added after) the darkened ground */
+static void coopTradePanel(s32 x, s32 y, s32 w, s32 h) {
+    coopTradeRect(x, y, w, 1, 0xF0, 0xB0, 0x20, 0);
+    coopTradeRect(x, y + h - 1, w, 1, 0xF0, 0xB0, 0x20, 0);
+    coopTradeRect(x, y, 1, h, 0xF0, 0xB0, 0x20, 0);
+    coopTradeRect(x + w - 1, y, 1, h, 0xF0, 0xB0, 0x20, 0);
+    coopTradeRect(x + 1, y + 1, w - 2, h - 2, 0x68, 0x68, 0x58, 1);
+}
+
+/* text (the game's, as its text files have it) at x, y in palette (PALETTE_*), no wider than maxW (0 any): its width */
+static s32 coopTradeText(const u8 *text, s32 x, s32 y, s32 palette, s32 maxW) {
+    Layer *layer = GFX.funcs.getLayer(FIELD_LAYER_TEXT);
+    u_long *ot = (u_long *)layer->getOtEntry(layer, 0);
+    TextStyle *style = &FONT.styles[1];
+    const u8 *p = text;
+    PrimPtr prim;
+    Glyph *g;
+    s32 c;
+    s32 kind;
+    s32 cx = 0;
+    s32 tpage;
+
+    prim.any = GFX.funcs.getPrim();
+    for (;;) {
+        c = FONT.decode(p, 0, style);
+        kind = (c >> 8) & 0xFF;
+        if (kind == 4 || *p == 0) {
+            break;
+        }
+        if (kind == 0) {
+            g = &style->glyphs[(c & 0xFF) - 4];
+            p += 1;
+        } else if (kind == 1) {
+            g = (c & 0xFF) > 0 && (c & 0xFF) <= style->iconCount ? &style->icons[(c & 0xFF) - 1] : style->glyphs;
+            p += 2;
+        } else if (kind == 2) {
+            p += p[1] < 11 && FONT.codeLengths[p[1]] > 0 ? FONT.codeLengths[p[1]] : 2; /* a new line: a space */
+            cx += 4;
+            continue;
+        } else {
+            g = style->glyphs;
+            p += 1;
+        }
+        if (g->page == 0xFF) {
+            g = style->glyphs;
+        }
+        if (maxW > 0 && cx + g->advance > maxW) {
+            break;
+        }
+        tpage = getTPage(0, style->blend == 0xFF ? 1 : style->blend & 3, 0x140 + (g->page << 6), 0);
+        setlen(prim.sprt, 4);
+        setcode(prim.sprt, 0x64);
+        if (style->blend != 0xFF) {
+            setSemiTrans(prim.sprt, 1);
+        }
+        prim.sprt->r0 = prim.sprt->g0 = prim.sprt->b0 = 0x80;
+        prim.sprt->x0 = x + cx + g->dx;
+        prim.sprt->y0 = y + g->dy;
+        prim.sprt->u0 = g->u;
+        prim.sprt->v0 = g->v;
+        prim.sprt->w = g->w;
+        prim.sprt->h = g->h;
+        prim.sprt->clut = getClut(0x140 + g->clutX, palette + g->clutY);
+        addPrim(ot, prim.any);
+        prim.sprt++;
+        SetDrawTPage(prim.tpage, 0, 1, tpage);
+        addPrim(ot, prim.any);
+        prim.tpage++;
+        cx += g->advance;
+    }
+    GFX.funcs.setPrim(prim.any);
+    return cx;
+}
+
+static const u8 *coopTradeString(s32 n) {
+    return (const u8 *)getString((s32 *)native_coop_text(LANGUAGE), COOP_TEXT_T(n));
+}
+
+/* Appends text (the game's, 0-ended) to buf of size */
+static void coopTradeCat(u8 *buf, s32 size, const u8 *text) {
+    s32 n = 0;
+
+    while (n < size - 1 && buf[n] != 0) {
+        n++;
+    }
+    while (n < size - 1 && *text != 0) {
+        buf[n++] = *text++;
+    }
+    buf[n] = 0;
+}
+
+/* A number in the game's digits (0 is 0x04), after prefix (a game character, 0 none) */
+static void coopTradeNumber(u8 *buf, s32 prefix, s32 value) {
+    s32 n = 0;
+
+    if (prefix != 0) {
+        buf[n++] = prefix;
+    }
+    if (value >= 10) {
+        buf[n++] = 0x04 + value / 10 % 10;
+    }
+    buf[n++] = 0x04 + value % 10;
+    buf[n] = 0;
+}
+
+/* A button's icon and its word: "(X) Ready" */
+static s32 coopTradeButton(s32 x, s32 y, s32 icon, s32 word) {
+    u8 buf[48];
+
+    buf[0] = 0x01;
+    buf[1] = icon;
+    buf[2] = 0x01; /* a space */
+    buf[3] = 0x01;
+    buf[4] = 0;
+    coopTradeCat(buf, sizeof buf, coopTradeString(word));
+    return coopTradeText(buf, x, y, PALETTE_WHITE, 0) + 12;
+}
+#define COOP_ICON_CROSS 0x1B
+#define COOP_ICON_CIRCLE 0x2F
+
+static const u8 *coopTradeName(s32 n, u8 *buf) {
+    NativeCoopState st;
+    s32 i;
+
+    buf[0] = 0;
+    if (native_coop_peer(n, &st)) {
+        for (i = 0; i < 15 && st.name[i] != 0; i++) {
+            buf[i] = st.name[i];
+        }
+        buf[i] = 0;
+    }
+    return buf;
+}
+
+static void coopTradeCardName(s32 card, s32 x, s32 y, s32 palette, s32 maxW) {
+    coopTradeText((const u8 *)getString(FILE_CACHE.load(TEXT_FILE(TEXT_CARD_NAMES)), card), x, y, palette, maxW);
+}
+
+/* A short window at the foot: line (built), and the buttons under it */
+static void coopTradeSmall(const u8 *line, s32 cross, s32 circle) {
+    s32 x = 0x18;
+
+    coopTradePanel(0x10, 0xA8, 0x120, 0x34);
+    coopTradeText(line, 0x18, 0xB0, PALETTE_WHITE, 0x110);
+    if (cross >= 0) {
+        x += coopTradeButton(x, 0xC6, COOP_ICON_CROSS, cross);
+    }
+    if (circle >= 0) {
+        coopTradeButton(x, 0xC6, COOP_ICON_CIRCLE, circle);
+    }
+}
+
+static void coopTradeOfferRows(const NativeCoopTrade *t, s32 x, s32 y) {
+    u8 num[8];
+    s32 i;
+
+    if (t->count == 0) {
+        coopTradeText(coopTradeString(T_NOTHING), x, y, PALETTE_GREY, 0);
+    }
+    for (i = 0; i < t->count; i++) {
+        coopTradeCardName(t->card[i], x, y + i * 12, PALETTE_WHITE, 0x6A);
+        coopTradeNumber(num, 0x3F, t->copies[i]); /* "x3" */
+        coopTradeText(num, x + 0x70, y + i * 12, PALETTE_YELLOW, 0);
+    }
+}
+
+static void coopTradeStatus(s32 phase, s32 x, s32 y) {
+    if (phase == COOP_TRADE_READY) {
+        coopTradeText(coopTradeString(T_READY), x, y, PALETTE_BLUE, 0);
+    } else if (phase == COOP_TRADE_CONFIRM || phase == COOP_TRADE_DONE) {
+        coopTradeText(coopTradeString(T_CONFIRMED), x, y, PALETTE_GREEN, 0);
+    }
+}
+
+static void coopTradeDraw(const NativeCoopTrade *mine, const NativeCoopTrade *in) {
+    u8 buf[96];
+    u8 name[16];
+    u8 num[8];
+    s32 i;
+    s32 c;
+    s32 y;
+    s32 x;
+    s32 both;
+
+    if (coopTrade.phase == COOP_TRADE_NONE) {
+        if (coopTrade.msgFrames > 0) {
+            buf[0] = 0;
+            if (coopTrade.msg == T_DECLINED) {
+                coopTradeCat(buf, sizeof buf, coopTradeName(coopTrade.msgPeer, name));
+            }
+            coopTradeCat(buf, sizeof buf, coopTradeString(coopTrade.msg));
+            coopTradeSmall(buf, -1, -1);
+        }
+        return;
+    }
+    if (coopTrade.phase == COOP_TRADE_MENU) {
+        coopTradePanel(0x10, 0x9A, 0x120, 0x42);
+        for (i = 0; i < 3; i++) {
+            if (coopTrade.menu == i) {
+                coopTradeRect(0x16, 0xA1 + i * 14, 0x110, 12, 0x20, 0x38, 0x80, 0);
+            }
+            coopTradeText(coopTradeString(i == 0 ? T_TALK : i == 1 ? T_TRADE_OPTION : T_BATTLE_OPTION), 0x1C,
+                          0xA2 + i * 14, coopTrade.menu == i ? PALETTE_YELLOW : PALETTE_WHITE, 0);
+        }
+        return;
+    }
+    if (coopTrade.kind == 1 && coopTrade.phase >= COOP_TRADE_OPEN) {
+        coopTradeSmall(coopTradeString(T_PREPARING), -1, T_LEAVE);
+        return;
+    }
+    if (coopTrade.phase == COOP_TRADE_ASK) {
+        coopTradeSmall(coopTradeString(T_WAIT_OTHER), -1, T_LEAVE);
+        return;
+    }
+    /* the trade: the title and who with, the two offers, the spare cards, a note, the buttons */
+    coopTradePanel(0x0C, 0x0C, 0x128, 0xDC);
+    coopTradeText(coopTradeString(T_TITLE), 0x14, 0x12, PALETTE_YELLOW, 0);
+    coopTradeText(coopTradeName(coopTrade.peer, name), 0xB4, 0x12, PALETTE_BLUE, 0x6C);
+    coopTradeRect(0x14, 0x22, 0x118, 1, 0x60, 0x50, 0x20, 0);
+    coopTradeText(coopTradeString(T_YOURS), 0x14, 0x26, PALETTE_GREEN, 0x50);
+    coopTradeStatus(coopTrade.phase, 0x68, 0x26);
+    coopTradeText(coopTradeString(T_THEIRS), 0xA4, 0x26, PALETTE_GREEN, 0x50);
+    coopTradeStatus(in->phase, 0xF8, 0x26);
+    coopTradeOfferRows(mine, 0x14, 0x34);
+    coopTradeOfferRows(in, 0xA4, 0x34);
+    coopTradeRect(0x14, 0x72, 0x118, 1, 0x60, 0x50, 0x20, 0);
+    coopTradeText(coopTradeString(T_SPARE), 0x14, 0x76, PALETTE_GREEN, 0);
+    if (coopTrade.count == 0) {
+        coopTradeText(coopTradeString(T_NO_SPARE), 0x14, 0x86, PALETTE_GREY, 0);
+    }
+    if (coopTrade.cursor < coopTrade.top) {
+        coopTrade.top = coopTrade.cursor;
+    }
+    if (coopTrade.cursor >= coopTrade.top + COOP_TRADE_ROWS) {
+        coopTrade.top = coopTrade.cursor - COOP_TRADE_ROWS + 1;
+    }
+    for (i = 0; i < COOP_TRADE_ROWS && coopTrade.top + i < coopTrade.count; i++) {
+        c = coopTrade.list[coopTrade.top + i];
+        y = 0x86 + i * 12;
+        if (coopTrade.top + i == coopTrade.cursor && coopTrade.phase == COOP_TRADE_OPEN) {
+            coopTradeRect(0x12, y - 1, 0x11C, 12, 0x20, 0x38, 0x80, 0);
+        }
+        coopTradeCardName(c, 0x18, y, coopTrade.offered[c] != 0 ? PALETTE_YELLOW : PALETTE_WHITE, 0xB0);
+        if (coopTrade.offered[c] != 0) {
+            num[0] = 0x01; /* "<2>": the copies that go */
+            num[1] = 0x1D;
+            coopTradeNumber(num + 2, 0, coopTrade.offered[c]);
+            coopTradeCat(num, sizeof num, (const u8 *)"\x01\x1E");
+            coopTradeText(num, 0xD0, y, PALETTE_YELLOW, 0);
+        }
+        coopTradeNumber(num, 0x3F, coopTrade.spare[c]); /* "x3": the spare copies */
+        coopTradeText(num, 0x108, y, PALETTE_WHITE, 0);
+    }
+    if (coopTrade.note >= 0) {
+        coopTradeText(coopTradeString(coopTrade.note), 0x14, 0xC4, PALETTE_RED, 0);
+    }
+    x = 0x14;
+    y = 0xD4;
+    both = in->phase >= COOP_TRADE_READY && in->phase <= COOP_TRADE_DONE;
+    if (coopTrade.phase == COOP_TRADE_OPEN) {
+        coopTradeText(coopTradeString(T_AMOUNT), 0x14, 0xC4 + (coopTrade.note >= 0 ? -12 : 0), PALETTE_GREY, 0);
+        x += coopTradeButton(x, y, COOP_ICON_CROSS, T_READY);
+        coopTradeButton(x, y, COOP_ICON_CIRCLE, T_LEAVE);
+    } else if (coopTrade.phase == COOP_TRADE_READY) {
+        if (both) {
+            x += coopTradeButton(x, y, COOP_ICON_CROSS, T_CONFIRM);
+        }
+        coopTradeButton(x, y, COOP_ICON_CIRCLE, T_CHANGE);
+    } else {
+        coopTradeText(coopTradeString(T_WAIT_DOTS), x, y, PALETTE_GREY, 0);
+    }
+}
+
+/* ---- The PvP battle: once two players waiting at a Guardromon to battle find each other, each sends its party (its
+   three partners, whole) and, with both parties across, both start the battle: the other's party as the enemies, the
+   save kept to be put back after (wfightmn/menu.c), fightstg/stats.c working out the enemies' stats from their
+   partners ---- */
+
+typedef struct CoopTeam { /* fightstg/stats.c has it too */
+    s32 party[3];
+    s32 ids[3];
+    Partner partners[3];
+    u32 coin; /* who goes first on a tie of speeds (the smaller): fightstg/stats.c's ends before it */
+} CoopTeam;
+
+static CoopTeam coopTeamMine;
+static CoopTeam coopTeamTheirs;
+static Battle coopPvpBattle = {1, 15, MUSIC(2, 0)}; /* an encounter of none, the arena's stage and music */
+
+static s32 coopPvpBlob(void) {
+    return (s32)((coopTrade.session & 0x7FFF) | 1);
+}
+
+static void coopPvpStart(void) {
+    s32 i;
+    s32 member;
+    PartnerStats *st;
+
+    /* a tie of speeds: the smaller coin first (a tie of coins too: the party's bytes, both see the same two) */
+    native_coop_pvp_begin(coopTrade.peer, &coopTeamTheirs, sizeof coopTeamTheirs, &GAME, coopPvpBlob(),
+                          coopTeamMine.coin != coopTeamTheirs.coin ? coopTeamMine.coin < coopTeamTheirs.coin
+                                                                   : memcmp(&coopTeamMine, &coopTeamTheirs, sizeof coopTeamMine) < 0);
+    native_coop_note("PvP battle with player %d", coopTrade.peer + 2);
+    coopTradeEnd(COOP_TRADE_DONE, -1);
+    coopTrade.quiet = 0;
+    /* an exhibition: both sides whole (the save comes back after anyway) */
+    for (i = 0; i < 3; i++) {
+        member = GAME.party[i];
+        if (member >= 0 && member < PARTNER_COUNT) {
+            st = &GAME.partners[member].info;
+            st->stats[STAT_HP] = st->stats[STAT_MAX_HP];
+            st->stats[STAT_MP] = st->stats[STAT_MAX_MP];
+        }
+    }
+    FIELDSTG_startBattle(&coopPvpBattle);
+    if (native_coop_raid_test() > 0) {
+        /* a raid (DW3_COOP_RAID, for now): the encounter's enemies, their HP times the players, both parties on this
+           side (wfightmn/menu.c) */
+        s32 enc = native_coop_raid_test();
+        s32 hp;
+
+        native_coop_raid_set(enc);
+        BATTLE_SETUP.battle = enc;
+        BATTLE_SETUP.ambushChance = 0;
+        BATTLE_SETUP.encounterKind = FIELDSTG_encounters[enc].kind;
+        BATTLE_SETUP.hasPrize = 0;
+        for (i = 0; i < 12; i++) {
+            BATTLE_SETUP.blocks[i] = FIELDSTG_encounters[enc].blocks[i];
+        }
+        for (i = 0; i < 3; i++) {
+            BATTLE_SETUP.enemies[i] = *FIELDSTG_encounters[enc].enemies[i];
+            hp = BATTLE_SETUP.enemies[i].hp * 2;
+            BATTLE_SETUP.enemies[i].hp = hp > 0x7FFF ? 0x7FFF : hp;
+        }
+        native_coop_note("Raid with player %d: encounter %d, %d HP", coopTrade.peer + 2, enc, BATTLE_SETUP.enemies[0].hp);
+        return;
+    }
+    BATTLE_SETUP.ambushChance = 0;
+    BATTLE_SETUP.encounterKind = 1;
+    BATTLE_SETUP.hasPrize = 0;
+    for (i = 0; i < 12; i++) {
+        BATTLE_SETUP.blocks[i] = 0;
+    }
+    for (i = 0; i < 3; i++) {
+        member = coopTeamTheirs.party[i];
+        BATTLE_SETUP.enemies[i].fighter = 0;
+        if (member < 0 || member >= PARTNER_COUNT) {
+            continue;
+        }
+        st = &coopTeamTheirs.partners[i].info;
+        BATTLE_SETUP.enemies[i].fighter = coopTeamTheirs.ids[i];
+        BATTLE_SETUP.enemies[i].level = st->stats[STAT_LEVEL];
+        BATTLE_SETUP.enemies[i].hp = st->stats[STAT_MAX_HP];
+        BATTLE_SETUP.enemies[i].mp = st->stats[STAT_MAX_MP];
+        BATTLE_SETUP.enemies[i].strength = 16;
+    }
+}
+
+/* The parties across (each side READY once it has both), then the battle, when both are */
+static void coopPvpUpdate(const NativeCoopTrade *in) {
+    s32 i;
+    s32 member;
+
+    if (!coopTrade.teamSent) {
+        for (i = 0; i < 3; i++) {
+            member = GAME.party[i];
+            coopTeamMine.party[i] = member;
+            coopTeamMine.ids[i] = member >= 0 && member < PARTNER_COUNT ? DIGIMON_DATA[member].id : 0;
+            if (i == 0 && member >= 0 && member < PARTNER_COUNT) {
+                s16 slots[4];
+
+                /* the first starts the battle as its battle digivolution, as on its own side (wfightmn/menu.c) */
+                if (GAME.funcs.getPartnerSlots(member, slots) > 0 && GAME.partners[member].battleDigivolve != 0) {
+                    coopTeamMine.ids[0] = GAME.partners[member].battleDigivolve;
+                }
+            }
+            if (member >= 0 && member < PARTNER_COUNT) {
+                coopTeamMine.partners[i] = GAME.partners[member];
+            }
+        }
+        coopTeamMine.coin = native_coop_coin();
+        native_coop_blob_send(coopTrade.peer, &coopTeamMine, sizeof coopTeamMine, coopPvpBlob());
+        coopTrade.teamSent = 1;
+    }
+    if (PAD_PRESSED(PAD_CIRCLE)) {
+        SOUND.playSound(SOUND_MENU_CANCEL);
+        coopTradeEnd(COOP_TRADE_NO, T_CANCELLED);
+        return;
+    }
+    if (g_coop_debug && coopTrade.frames % 30 == 0) {
+        native_log("coop: PvP wait: phase %d session %X; theirs phase %d session %X; blob in %d, ours across %d",
+                   coopTrade.phase, coopTrade.session, in->phase, in->session,
+                   native_coop_blob_recv(coopTrade.peer, coopPvpBlob(), &coopTeamTheirs, sizeof coopTeamTheirs),
+                   native_coop_blob_sent(coopTrade.peer, coopPvpBlob()));
+    }
+    if (coopTrade.phase == COOP_TRADE_OPEN &&
+        native_coop_blob_recv(coopTrade.peer, coopPvpBlob(), &coopTeamTheirs, sizeof coopTeamTheirs) == sizeof coopTeamTheirs &&
+        native_coop_blob_sent(coopTrade.peer, coopPvpBlob())) {
+        coopTrade.phase = COOP_TRADE_READY;
+    }
+    /* both ready: "go" goes out a few frames (the field is left at once after), then the battle */
+    if (coopTrade.phase == COOP_TRADE_READY && in->session == coopTrade.session && in->phase >= COOP_TRADE_READY &&
+        in->phase <= COOP_TRADE_DONE) {
+        coopTrade.phase = COOP_TRADE_CONFIRM;
+        coopTrade.frames = 0;
+    }
+    if (coopTrade.phase == COOP_TRADE_CONFIRM && coopTrade.frames >= 10) {
+        coopPvpStart();
+    }
+}
+
+/* Every frame of the field with co-op on */
+static void coopTradeUpdate(void) {
+    NativeCoopTrade in;
+    NativeCoopTrade out;
+    NativeCoopState st;
+    u32 theirs;
+    s32 here;
+    s32 n;
+    s32 c;
+    s32 i;
+
+    out.session = 0;
+    out.phase = COOP_TRADE_NONE;
+    out.count = 0;
+    out.offer = out.seen = 0;
+    in.session = 0;
+    in.phase = COOP_TRADE_NONE;
+    in.count = 0;
+    in.offer = in.seen = 0;
+    coopTrade.frames++;
+    if (coopTrade.quiet > 0) {
+        coopTrade.quiet--;
+    }
+    if (coopTrade.msgFrames > 0) {
+        coopTrade.msgFrames--;
+    }
+    if (coopTrade.phase == COOP_TRADE_NONE && coopTrade.frames > 200 && coopTradeFree() && (i = native_coop_auto()) >= 0) {
+        coopTradeStart(-1, 0, COOP_TRADE_ASK); /* tests: as if a Guardromon's choice had been made */
+        coopTrade.kind = i;
+        coopTrade.session = (((u32)GFX.funcs.getTime() * 2654435761u) ^ ((u32)GAME.playFrames << 7)) | 1;
+    }
+    n = native_coop_test_cards();
+    for (c = 1; c <= 5 && n > 0; c++) {
+        GAME.funcs.addCards(c, n);
+    }
+
+    if (coopTrade.phase != COOP_TRADE_NONE) {
+        here = coopTrade.peer >= 0 && native_coop_trade_in(coopTrade.peer, &in) && coopTradePeer(coopTrade.peer, &st);
+        theirs = coopTradeHash(&in);
+        switch (coopTrade.phase) {
+        case COOP_TRADE_MENU:
+            if (PAD_PRESSED(PAD_UP) || PAD_PRESSED(PAD_DOWN)) {
+                coopTrade.menu = (coopTrade.menu + (PAD_PRESSED(PAD_UP) ? 2 : 1)) % 3;
+                SOUND.playSound(SOUND_CURSOR);
+            } else if (PAD_PRESSED(PAD_CIRCLE) || (PAD_PRESSED(PAD_CROSS) && coopTrade.menu == 0)) {
+                /* his own talk (saving), as if this weren't here */
+                coopTradeEnd(COOP_TRADE_NONE, -1);
+                coopTrade.passing = 1;
+                FIELDSTG_talkToActorAt(coopTrade.talker, &coopTrade.talkAt);
+                coopTrade.passing = 0;
+            } else if (PAD_PRESSED(PAD_CROSS)) {
+                coopTrade.kind = coopTrade.menu == 2;
+                coopTrade.teamSent = 0;
+                coopTrade.phase = COOP_TRADE_ASK; /* wait for another player at a Guardromon */
+                coopTrade.session = (((u32)GFX.funcs.getTime() * 2654435761u) ^ ((u32)GAME.playFrames << 7)) | 1;
+                coopTrade.frames = 0;
+                SOUND.playSound(SOUND_SELECT);
+            }
+            break;
+        case COOP_TRADE_ASK:
+            /* another player waiting too: the one of smallest session, and that session for both */
+            n = -1;
+            for (i = 0; i < native_coop_peer_slots() && i < COOP_GHOSTS; i++) {
+                NativeCoopTrade other;
+
+                if (native_coop_trade_in(i, &other) && other.session != 0 &&
+                    other.pad[0] == coopTrade.kind && (other.phase == COOP_TRADE_ASK ||
+                     (other.phase == COOP_TRADE_OPEN && other.session == coopTrade.session)) &&
+                    (n < 0 || other.session < in.session)) {
+                    n = i;
+                    in = other;
+                }
+            }
+            if (n >= 0) {
+                coopTrade.peer = n;
+                if (in.session < coopTrade.session) {
+                    coopTrade.session = in.session;
+                }
+                coopTrade.phase = COOP_TRADE_OPEN;
+                coopTrade.frames = 0;
+                coopTradeList();
+                SOUND.playSound(SOUND_MENU_OPEN);
+            } else if (coopTrade.frames > COOP_TRADE_WAIT || PAD_PRESSED(PAD_CIRCLE)) {
+                SOUND.playSound(SOUND_MENU_CANCEL);
+                coopTradeEnd(COOP_TRADE_NONE, -1);
+            }
+            break;
+        default: /* open, ready, confirmed */
+            if (g_coop_debug && (!here || in.phase == COOP_TRADE_NO || (in.phase != COOP_TRADE_ASK && in.session != coopTrade.session))) {
+                native_log("coop: trade ends: here %d, theirs phase %d session %X, ours %X", here, in.phase, in.session,
+                           coopTrade.session);
+            }
+            if (!here || in.phase == COOP_TRADE_NO ||
+                (in.phase == COOP_TRADE_ASK ? coopTrade.frames > 60 : in.session != coopTrade.session) ||
+                (in.phase == COOP_TRADE_NONE && coopTrade.frames > 30)) {
+                coopTradeEnd(COOP_TRADE_NO, T_CANCELLED);
+                break;
+            }
+            if (coopTrade.kind == 1) {
+                coopPvpUpdate(&in);
+                break;
+            }
+            if (coopTrade.phase == COOP_TRADE_OPEN) {
+                coopTradeList();
+                if (coopTrade.count > 0 && (PAD_PRESSED(PAD_UP) || PAD_REPEATED(PAD_UP))) {
+                    coopTrade.cursor = (coopTrade.cursor + coopTrade.count - 1) % coopTrade.count;
+                    SOUND.playSound(SOUND_CURSOR);
+                } else if (coopTrade.count > 0 && (PAD_PRESSED(PAD_DOWN) || PAD_REPEATED(PAD_DOWN))) {
+                    coopTrade.cursor = (coopTrade.cursor + 1) % coopTrade.count;
+                    SOUND.playSound(SOUND_CURSOR);
+                } else if (coopTrade.count > 0 && (PAD_PRESSED(PAD_RIGHT) || PAD_REPEATED(PAD_RIGHT))) {
+                    c = coopTrade.list[coopTrade.cursor];
+                    if (coopTrade.offered[c] == 0 && coopTradeKinds() >= COOP_TRADE_KINDS) {
+                        coopTrade.note = T_FULL;
+                    } else if (coopTrade.offered[c] < coopTrade.spare[c]) {
+                        coopTrade.offered[c]++;
+                        coopTrade.note = -1;
+                        SOUND.playSound(SOUND_CURSOR);
+                    }
+                } else if (coopTrade.count > 0 && (PAD_PRESSED(PAD_LEFT) || PAD_REPEATED(PAD_LEFT))) {
+                    c = coopTrade.list[coopTrade.cursor];
+                    if (coopTrade.offered[c] > 0) {
+                        coopTrade.offered[c]--;
+                        coopTrade.note = -1;
+                        SOUND.playSound(SOUND_CURSOR);
+                    }
+                } else if (PAD_PRESSED(PAD_CROSS)) {
+                    if (!coopTradeRoom(&in)) {
+                        coopTrade.note = T_NO_ROOM;
+                    } else {
+                        coopTrade.phase = COOP_TRADE_READY;
+                        coopTrade.readyTheirs = theirs;
+                        coopTrade.note = -1;
+                        SOUND.playSound(SOUND_SELECT);
+                    }
+                } else if (PAD_PRESSED(PAD_CIRCLE)) {
+                    SOUND.playSound(SOUND_MENU_CANCEL);
+                    coopTradeEnd(COOP_TRADE_NO, T_CANCELLED);
+                    break;
+                }
+            } else if (coopTrade.phase == COOP_TRADE_READY) {
+                coopTradeOffer(&out);
+                if (theirs != coopTrade.readyTheirs || !coopTradeRoom(&in)) {
+                    coopTrade.phase = COOP_TRADE_OPEN; /* their offer changed: look again */
+                } else if (PAD_PRESSED(PAD_CIRCLE)) {
+                    coopTrade.phase = COOP_TRADE_OPEN;
+                    SOUND.playSound(SOUND_MENU_CANCEL);
+                } else if (PAD_PRESSED(PAD_CROSS) && in.phase >= COOP_TRADE_READY && in.phase <= COOP_TRADE_DONE &&
+                           in.seen == out.offer && in.offer == theirs && (out.count > 0 || in.count > 0)) {
+                    coopTrade.phase = COOP_TRADE_CONFIRM;
+                    SOUND.playSound(SOUND_SELECT);
+                }
+            } else if (coopTrade.phase == COOP_TRADE_CONFIRM) {
+                coopTradeOffer(&out);
+                if (theirs != coopTrade.readyTheirs || in.phase == COOP_TRADE_OPEN) {
+                    coopTrade.phase = COOP_TRADE_OPEN; /* they went back before confirming: so does this side */
+                } else if ((in.phase == COOP_TRADE_CONFIRM || in.phase == COOP_TRADE_DONE) && in.seen == out.offer &&
+                           in.offer == theirs) {
+                    /* both confirmed the same: theirs in, mine out, once */
+                    for (i = 0; i < out.count; i++) {
+                        GAME.cards[out.card[i]] -= out.copies[i];
+                        if (GAME.cards[out.card[i]] < 0) {
+                            GAME.cards[out.card[i]] = 0;
+                        }
+                    }
+                    for (i = 0; i < in.count; i++) {
+                        GAME.funcs.addCards(in.card[i], in.copies[i]);
+                    }
+                    native_coop_note("card trade with player %d: gave %d (%d x%d, %d x%d...), got %d (%d x%d, %d x%d...); "
+                                     "card 1 now %d, card 2 now %d", coopTrade.peer + 2, out.count, out.card[0],
+                                     out.copies[0], out.card[1], out.copies[1], in.count, in.card[0], in.copies[0],
+                                     in.card[1], in.copies[1], GAME.cards[1], GAME.cards[2]);
+                    SOUND.playSound(SOUND_MENU_CONFIRM);
+                    coopTradeEnd(COOP_TRADE_DONE, T_DONE);
+                }
+            }
+            break;
+        }
+    }
+
+    /* what goes to each player: the trade's side to the one traded with, the last word a while, nothing to the rest */
+    for (n = 0; n < native_coop_peer_slots() && n < COOP_GHOSTS; n++) {
+        NativeCoopTrade send;
+
+        send.session = 0;
+        send.phase = COOP_TRADE_NONE;
+        send.count = 0;
+        send.offer = send.seen = 0;
+        send.pad[0] = send.pad[1] = 0;
+        if (coopTrade.phase == COOP_TRADE_ASK) {
+            send.session = coopTrade.session; /* waiting: to everyone */
+            send.phase = COOP_TRADE_ASK;
+            send.pad[0] = coopTrade.kind;
+            send.offer = coopTradeHash(&send);
+        } else if (coopTrade.phase >= COOP_TRADE_OPEN && coopTrade.phase <= COOP_TRADE_DONE && n == coopTrade.peer) {
+            coopTradeOffer(&send);
+            send.session = coopTrade.session;
+            send.phase = coopTrade.phase;
+            send.pad[0] = coopTrade.kind;
+            send.seen = coopTradeHash(&in);
+        } else if (coopTrade.linger > 0 && n == coopTrade.msgPeer) {
+            send = coopTrade.last;
+        }
+        native_coop_trade_out(n, &send);
+    }
+    if (coopTrade.linger > 0) {
+        coopTrade.linger--;
+    }
+    if (coopTrade.phase != COOP_TRADE_NONE) {
+        coopTradeOffer(&out);
+    }
+    native_coop_tags_block(coopTrade.phase != COOP_TRADE_NONE || coopTrade.msgFrames > 0);
+    coopTradeDraw(&out, &in);
+}
