 #include "stitshop.h"
 
+#ifdef NATIVE
+/* The disc's Spanish has "Buy" and "Sell" in English here: those two are the co-op's own (tools/coop_text.py) */
+#define LANGUAGE_SPANISH 6
+static void shopVerb(TextWindow *window, s32 index, s32 own) {
+    if (LANGUAGE == LANGUAGE_SPANISH) {
+        window->setString(window, (void *)native_coop_text(LANGUAGE), own);
+    } else {
+        window->setString(window, FILE_CACHE.load(TEXT_FILE(TEXT_ITEM_SHOP)), index);
+    }
+}
+#define SHOP_VERB(window, index, own) shopVerb((window), (index), (own))
+#else
+#define SHOP_VERB(window, index, own) (window)->setString((window), FILE_CACHE.load(TEXT_FILE(TEXT_ITEM_SHOP)), (index))
+#endif
