 #include "wfightmn.h"
 
+#ifdef NATIVE
+/* the co-op's PvP battle (fightstg/enemy_turn.c) */
+void FIGHTSTG_coopPvpTake(const NativeCoopCommand *c);
+void FIGHTSTG_coopPvpSend(s32 action, s32 arg, s32 digimon, s32 knockOut);
+/* the PvP battle ended (its save put back): the end's last state runs every frame till the field comes, and has to go
+   on to the field, not to the report or the title */
+static s32 coopPvpEnded;
+
+/* ---- The raid (fieldstg/field.c): the players' parties (2 to 4) on this side against the boss, turn about: each
+   seat's turn in order, then the boss's at each seat standing, round again. The side shows one party at a time:
+   GAME's party and partners loaded with that seat's (this player's own kept whole, and put back for its turns and at
+   the end) and the fighters with them; a turn of a party not shown brings it in first (coopRaidHandover). This
+   player's turns are picked in its menu and sent, the others' taken from their players. The boss's rolls are seeded
+   from the battle and the turn, the same in every game. ---- */
+#define COOP_RAID_HANDOVER 40 /* runTurn's substate: the party of coopRaid.target comes in */
+typedef struct CoopRaidTeam { /* fieldstg/field.c's CoopTeam */
+    s32 party[3];
+    s32 ids[3];
+    Partner partners[3];
+} CoopRaidTeam;
+
+static struct {
+    s32 players;
+    s32 me;      /* this player's seat */
+    s32 shown;   /* the seat whose party is on the side */
+    s32 turn;    /* the turns given out */
+    s32 actor;   /* this turn's: a seat, or COOP_RAID_SEATS the boss */
+    s32 target;  /* the seat brought in for it */
+    s32 pending; /* the event to run once it's in */
+    s32 ready;   /* the turn is given out: runTurn runs it as it is */
+    s32 out[COOP_RAID_SEATS]; /* the seat's party is down (or its player left) */
+    s32 hasCommand;
+    NativeCoopCommand command; /* the shown seat's player's, for its turn or its pick */
+    BattleFighter fighters[COOP_RAID_SEATS][3]; /* each seat's, while off the side */
+    s32 active[COOP_RAID_SEATS];
+    QueuedEvent stash[COOP_RAID_SEATS][16]; /* each seat's events (statuses, boosts...) while off the side */
+    u8 result[COOP_RAID_SEATS][sizeof(BATTLE_RESULT.partners)]; /* each seat's who-fought, while off the side */
+    s32 myParty[3];
+    Partner myPartners[PARTNER_COUNT]; /* this player's, whole, while another party is loaded */
+} coopRaid;
+
+/* the events of a party's fighters (by their slot): kept apart while the party is off the side */
+static s32 coopRaidPartyEvent(QueuedEvent *e) {
+    switch (e->type) {
+    case EVENT_AUTO_RECOVER_END:
+    case EVENT_RECOVERY:
+    case EVENT_PARTNER_TECH:
+    case EVENT_STATUS_DAMAGE:
+    case EVENT_STATUS_END:
+    case EVENT_STATUS_END + 1:
+    case EVENT_STATUS_END + 2:
+    case EVENT_BOOST_END:
+    case EVENT_BOOST_END + 1:
+    case EVENT_BOOST_END + 2:
+    case EVENT_RESTRICTION_END:
+    case EVENT_RESTRICTION_END + 1:
+    case EVENT_BLAST_END:
+    case EVENT_SPECIAL_END:
+    case EVENT_DIGIDEVOLVE:
+        return e->args[0] == 0;
+    default:
+        return 0;
+    }
+}
+
+/* the turn is a party's not this player's: its player's command, not this side's menu */
+static s32 coopRaidRemote(void) {
+    return native_coop_raid() != NULL && coopRaid.shown != coopRaid.me;
+}
+
+/* another seat than the shown one still standing */
+static s32 coopRaidOthersStanding(void) {
+    s32 i;
+
+    for (i = 0; i < coopRaid.players; i++) {
+        if (i != coopRaid.shown && !coopRaid.out[i]) {
+            return 1;
+        }
+    }
+    return 0;
+}
+
+/* seat's party on the side: the shown one's kept (its party and partners, fighters, who-fought, events), seat's loaded */
+static void coopRaidShow(s32 seat) {
+    NativeCoopPvp *raid = native_coop_raid();
+    CoopRaidTeam *team;
+    s32 from = coopRaid.shown;
+    s32 i;
+    s32 k;
+
+    if (seat == from) {
+        return;
+    }
+    /* keep the shown one's */
+    if (from == coopRaid.me) {
+        memcpy(coopRaid.myParty, GAME.party, sizeof coopRaid.myParty);
+        memcpy(coopRaid.myPartners, GAME.partners, sizeof coopRaid.myPartners);
+    } else {
+        team = (CoopRaidTeam *)raid->teams[from];
+        for (i = 0; i < 3; i++) {
+            team->party[i] = GAME.party[i];
+            if (GAME.party[i] >= 0 && GAME.party[i] < PARTNER_COUNT) {
+                team->partners[i] = GAME.partners[GAME.party[i]];
+            }
+        }
+    }
+    memcpy(coopRaid.fighters[from], FIGHTSTG_battle.fighters[0], sizeof coopRaid.fighters[from]);
+    coopRaid.active[from] = FIGHTSTG_battle.active[0];
+    memcpy(coopRaid.result[from], BATTLE_RESULT.partners, sizeof coopRaid.result[from]);
+    memset(coopRaid.stash[from], 0, sizeof coopRaid.stash[from]);
+    for (i = 0, k = 0; i < 99; i++) {
+        if (coopRaidPartyEvent(&FIGHTSTG_events.events[i]) && k < 16) {
+            coopRaid.stash[from][k++] = FIGHTSTG_events.events[i];
+            FIGHTSTG_events.events[i].type = 0;
+        }
+    }
+    /* load seat's */
+    if (seat == coopRaid.me) {
+        memcpy(GAME.party, coopRaid.myParty, sizeof coopRaid.myParty);
+        memcpy(GAME.partners, coopRaid.myPartners, sizeof coopRaid.myPartners);
+    } else {
+        team = (CoopRaidTeam *)raid->teams[seat];
+        for (i = 0; i < 3; i++) {
+            GAME.party[i] = team->party[i];
+            if (team->party[i] >= 0 && team->party[i] < PARTNER_COUNT) {
+                GAME.partners[team->party[i]] = team->partners[i];
+            }
+        }
+    }
+    memcpy(FIGHTSTG_battle.fighters[0], coopRaid.fighters[seat], sizeof coopRaid.fighters[seat]);
+    FIGHTSTG_battle.active[0] = coopRaid.active[seat];
+    memcpy(BATTLE_RESULT.partners, coopRaid.result[seat], sizeof coopRaid.result[seat]);
+    for (k = 0, i = 0; k < 16 && coopRaid.stash[seat][k].type != 0; k++) {
+        while (i < 99 && FIGHTSTG_events.events[i].type != 0) {
+            i++;
+        }
+        if (i == 99) {
+            break;
+        }
+        FIGHTSTG_events.events[i] = coopRaid.stash[seat][k];
+    }
+    memset(coopRaid.stash[seat], 0, sizeof coopRaid.stash[seat]);
+    coopRaid.shown = seat;
+}
+
+/* the battle starts: this player's party on the side, the others' whole, seat 0 first */
+static void coopRaidBegin(void) {
+    NativeCoopPvp *raid = native_coop_raid();
+    CoopRaidTeam *team;
+    PartnerStats *st;
+    s32 s;
+    s32 i;
+
+    memset(&coopRaid, 0, sizeof coopRaid);
+    coopRaid.players = raid->players;
+    coopRaid.me = raid->me;
+    coopRaid.shown = coopRaid.me;
+    for (s = 0; s < coopRaid.players; s++) {
+        if (s == coopRaid.me) {
+            continue;
+        }
+        team = (CoopRaidTeam *)raid->teams[s];
+        for (i = 0; i < 3; i++) {
+            if (team->party[i] < 0 || team->party[i] >= PARTNER_COUNT) {
+                continue;
+            }
+            st = &team->partners[i].info;
+            coopRaid.fighters[s][i].id = team->ids[i];
+            coopRaid.fighters[s][i].hp = coopRaid.fighters[s][i].maxHp = st->stats[STAT_MAX_HP];
+            coopRaid.fighters[s][i].mp = coopRaid.fighters[s][i].maxMp = st->stats[STAT_MAX_MP];
+        }
+    }
+    native_coop_note("Raid: %d players, this one is seat %d", coopRaid.players, coopRaid.me);
+}
+
+/* a player turn or the boss's came: gives out the next turn (the seats standing in order, then the boss at each),
+   the one queued dropped for it, and brings in the party it needs */
+static void coopRaidNextTurn(BattleMenu *task) {
+    s32 n = coopRaid.players * 2;
+    s32 i;
+    s32 k = 0;
+    u32 seed;
+
+    for (i = 0; i < 99; i++) {
+        if (i != FIGHTSTG_events.curIndex &&
+            (FIGHTSTG_events.events[i].type == EVENT_PLAYER_TURN || FIGHTSTG_events.events[i].type == EVENT_ENEMY_TURN)) {
+            FIGHTSTG_events.events[i].type = 0;
+        }
+    }
+    /* a round: each seat, then the boss at each (k past the seats); a seat down is skipped */
+    for (i = 0; i < n; i++) {
+        k = coopRaid.turn % n;
+        coopRaid.turn++;
+        if (!coopRaid.out[k % coopRaid.players]) {
+            break;
+        }
+    }
+    coopRaid.target = k % coopRaid.players;
+    if (k >= coopRaid.players) {
+        /* the boss: its rolls from the battle and the turn, the same in every game */
+        coopRaid.actor = COOP_RAID_SEATS;
+        seed = ((u32)native_coop_raid()->battle * 2654435761u) ^ ((u32)coopRaid.turn * 40503u);
+        native_coop_pvp_seed(seed);
+        coopRaid.pending = EVENT_ENEMY_TURN;
+    } else {
+        coopRaid.actor = k;
+        coopRaid.pending = EVENT_PLAYER_TURN;
+    }
+    if (g_coop_debug) {
+        native_coop_note("Raid: turn %d: %s, seat %d on; HP %d/%d/%d, boss %d", coopRaid.turn,
+                         coopRaid.actor == COOP_RAID_SEATS ? "the boss" : coopRaid.actor == coopRaid.me ? "this player" : "another",
+                         coopRaid.target, FIGHTSTG_battle.fighters[0][0].hp, FIGHTSTG_battle.fighters[0][1].hp,
+                         FIGHTSTG_battle.fighters[0][2].hp, FIGHTSTG_battle.fighters[1][FIGHTSTG_battle.active[1]].hp);
+    }
+    if (coopRaid.target != coopRaid.shown) {
+        task->setSubstate(task, COOP_RAID_HANDOVER);
+        return;
+    }
+    coopRaid.ready = 1;
+    task->step = coopRaid.pending;
+}
+
+/* runTurn's COOP_RAID_HANDOVER: the target's party in, its active fighter's entrance, then the pending turn */
+static void coopRaidHandover(BattleMenu *task, BattleMenuChildren *children) {
+    BattleFighter *unit;
+    s32 i;
+
+    switch (task->step) {
+    case 0:
+    default:
+        if (children->task.task != NULL) {
+            break;
+        }
+        WFIGHTMN_cancelBlast();
+        coopRaidShow(coopRaid.target);
+        unit = &FIGHTSTG_battle.fighters[0][FIGHTSTG_battle.active[0]];
+        if (unit->hp == 0) { /* its active one fell before: the first standing */
+            for (i = 0; i < 3; i++) {
+                if (FIGHTSTG_battle.fighters[0][i].id != 0 && FIGHTSTG_battle.fighters[0][i].hp != 0) {
+                    FIGHTSTG_battle.active[0] = i;
+                    break;
+                }
+            }
+            unit = &FIGHTSTG_battle.fighters[0][FIGHTSTG_battle.active[0]];
+        }
+        children->task.entrance = FIGHTSTG_startEntrance(unit->id, 0, WFIGHTMN_setIdleMotion(0, 0));
+        task->step++;
+        break;
+    case 1:
+        if (children->task.entrance->done != 0) {
+            task->step++;
+        }
+        break;
+    case 2:
+        if (children->task.task == NULL) {
+            task->setSubstate(task, 1);
+            coopRaid.ready = 1;
+            task->step = coopRaid.pending;
+        }
+        break;
+    }
+}
+
+/* the shown seat's player's command (its turn, or its pick), kept till it's used: 1 here, 0 not yet; the player gone,
+   its seat is down */
+static s32 coopRaidCommand(void) {
+    s32 got;
+    s32 side;
+    s32 i;
+
+    if (coopRaid.hasCommand) {
+        return 1;
+    }
+    got = native_coop_raid_take(coopRaid.shown, &coopRaid.command);
+    if (got < 0) {
+        native_coop_note("Raid: seat %d's player left: its party is out", coopRaid.shown);
+        coopRaid.out[coopRaid.shown] = 1;
+        memset(&coopRaid.command, 0, sizeof coopRaid.command);
+        coopRaid.command.action = -1;
+        coopRaid.hasCommand = 1;
+        return 1;
+    }
+    if (got == 0) {
+        return 0;
+    }
+    /* its fighters as it had them: the boss, and the party on (its own, as here) */
+    for (side = 0; side < 2; side++) {
+        for (i = 0; i < 3; i++) {
+            if (FIGHTSTG_battle.fighters[side][i].id != 0 && FIGHTSTG_battle.fighters[side][i].hp != coopRaid.command.hp[side][i]) {
+                native_coop_note("Raid: %s %d is HP %d here, %d there", side ? "enemy" : "partner", i,
+                                 FIGHTSTG_battle.fighters[side][i].hp, coopRaid.command.hp[side][i]);
+            }
+        }
+    }
+    coopRaid.hasCommand = 1;
+    return 1;
+}
+
+/* the seat whose party is on the side, for the HUD (fightstg/hud.c): -1 when no raid */
+s32 WFIGHTMN_coopRaidShown(void) {
+    return native_coop_raid() != NULL ? coopRaid.shown : -1;
+}
+
+/* A raid won: an item sure, of the boss's tier (the rare ones the enemies leave, or carry) */
+static s32 coopRaidLoot(s32 tier) {
+    static const s16 LOW[] = {0x2B, 0x2C, 0x153, 0x156, 0x159, 0x15C, 0x15F, 0x162, 0x165, 0x13C, 0x140, 0x143, 0x145};
+    static const s16 MIDDLE[] = {0x2D, 0x154, 0x157, 0x15A, 0x15D, 0x160, 0x163, 0x166, 0x2F, 0x30, 0x31, 0x32, 0x33,
+                                 0x34, 0x35, 0x151, 0x14B, 0x14D, 0x14F, 0x147, 0x149};
+    static const s16 HIGH[] = {0x2E, 0x155, 0x158, 0x15B, 0x15E, 0x161, 0x164, 0x167, 0x37, 0x38, 0x39, 0x3A, 0x3B,
+                               0x3C, 0x3D, 0x3E, 0x3F, 0x40, 0x41, 0x152, 0x14E, 0x150, 0x14C, 0x148, 0x14A, 0x144,
+                               0x146, 0x55};
+
+    if (tier >= 2) {
+        return HIGH[RANDOM.next() % (sizeof HIGH / sizeof HIGH[0])];
+    }
+    if (tier == 1) {
+        return MIDDLE[RANDOM.next() % (sizeof MIDDLE / sizeof MIDDLE[0])];
+    }
+    return LOW[RANDOM.next() % (sizeof LOW / sizeof LOW[0])];
+}
+
+/* its rolls from now on, and the command used up */
+static void coopRaidUseCommand(void) {
+    if (coopRaid.command.seed != 0) {
+        native_coop_pvp_seed(coopRaid.command.seed);
+    }
+    coopRaid.hasCommand = 0;
+}
