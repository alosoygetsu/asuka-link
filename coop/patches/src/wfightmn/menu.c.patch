 #include "wfightmn.h"
 
+#ifdef NATIVE
+/* the co-op's PvP battle (fightstg/enemy_turn.c) */
+void FIGHTSTG_coopPvpTake(const NativeCoopCommand *c);
+void FIGHTSTG_coopPvpSend(s32 action, s32 arg, s32 digimon, s32 knockOut);
+/* the PvP battle ended (its save put back): the end's last state runs every frame till the field comes, and has to go
+   on to the field, not to the report or the title */
+static s32 coopPvpEnded;
+
+/* ---- The raid (fieldstg/field.c): both players' parties on this side against the boss, turn about: seat 0's turn,
+   seat 1's, then the boss's at each, round again. The side shows one party at a time, the GAME's party and partners swapped for the
+   other's (as fightstg/stats.c does for the PvP's enemy) and the fighters with them; a turn of the party not shown
+   brings it in first (coopRaidHandover). This side's turns are picked in its menu and sent, the other's taken from it.
+   The boss's rolls are seeded from the battle and the turn, the same in both games. ---- */
+#define COOP_RAID_HANDOVER 40 /* runTurn's substate: the party of coopRaid.target comes in */
+typedef struct CoopRaidTeam { /* fieldstg/field.c's CoopTeam */
+    s32 party[3];
+    s32 ids[3];
+    Partner partners[3];
+} CoopRaidTeam;
+
+static struct {
+    s32 me;      /* this player's seat: 0 goes first */
+    s32 shown;   /* the seat whose party is on the side */
+    s32 turn;    /* the turns given out */
+    s32 actor;   /* this turn's: a seat, or 2 the boss */
+    s32 target;  /* the seat brought in for it */
+    s32 pending; /* the event to run once it's in */
+    s32 ready;   /* the turn is given out: runTurn runs it as it is */
+    s32 out[2];  /* the seat's party is down (or the player left) */
+    s32 hasCommand;
+    NativeCoopCommand command; /* the other's, for its turn */
+    BattleFighter fighters[3]; /* the party not shown */
+    s32 active;
+    QueuedEvent stash[2][16]; /* each seat's events (statuses, boosts...) while its party isn't shown */
+    u8 result[sizeof(BATTLE_RESULT.partners)]; /* the party not shown's BATTLE_RESULT.partners (who fought) */
+} coopRaid;
+
+/* the events of a party's fighters (by their slot): kept apart while the party is off the side */
+static s32 coopRaidPartyEvent(QueuedEvent *e) {
+    switch (e->type) {
+    case EVENT_AUTO_RECOVER_END:
+    case EVENT_RECOVERY:
+    case EVENT_PARTNER_TECH:
+    case EVENT_STATUS_DAMAGE:
+    case EVENT_STATUS_END:
+    case EVENT_STATUS_END + 1:
+    case EVENT_STATUS_END + 2:
+    case EVENT_BOOST_END:
+    case EVENT_BOOST_END + 1:
+    case EVENT_BOOST_END + 2:
+    case EVENT_RESTRICTION_END:
+    case EVENT_RESTRICTION_END + 1:
+    case EVENT_BLAST_END:
+    case EVENT_SPECIAL_END:
+    case EVENT_DIGIDEVOLVE:
+        return e->args[0] == 0;
+    default:
+        return 0;
+    }
+}
+
+/* the side's party's events to its stash, and the incoming one's back to the queue */
+static void coopRaidSwapEvents(s32 from, s32 to) {
+    QueuedEvent *stash;
+    s32 i;
+    s32 k = 0;
+
+    stash = coopRaid.stash[from];
+    memset(stash, 0, sizeof coopRaid.stash[from]);
+    for (i = 0; i < 99; i++) {
+        if (coopRaidPartyEvent(&FIGHTSTG_events.events[i]) && k < 16) {
+            stash[k++] = FIGHTSTG_events.events[i];
+            FIGHTSTG_events.events[i].type = 0;
+        }
+    }
+    stash = coopRaid.stash[to];
+    for (k = 0, i = 0; k < 16 && stash[k].type != 0; k++) {
+        while (i < 99 && FIGHTSTG_events.events[i].type != 0) {
+            i++;
+        }
+        if (i == 99) {
+            break;
+        }
+        FIGHTSTG_events.events[i] = stash[k];
+    }
+    memset(stash, 0, sizeof coopRaid.stash[to]);
+}
+
+/* this turn is the other player's: its command, not this side's menu */
+static s32 coopRaidRemote(void) {
+    return native_coop_raid() != NULL && coopRaid.shown != coopRaid.me;
+}
+
+static void coopRaidSwapBytes(u8 *a, u8 *b, s32 n) {
+    u8 t;
+
+    while (n-- > 0) {
+        t = *a;
+        *a++ = *b;
+        *b++ = t;
+    }
+}
+
+/* the parties trade places: GAME's party and its partners with the other's, the side's fighters with those kept */
+static void coopRaidSwap(void) {
+    CoopRaidTeam *team = (CoopRaidTeam *)native_coop_raid()->team;
+    s32 i;
+    s32 k;
+
+    if (coopRaid.shown == coopRaid.me) {
+        for (i = 0; i < 3; i++) { /* the other's in: the party first, then its partners */
+            k = GAME.party[i];
+            GAME.party[i] = team->party[i];
+            team->party[i] = k;
+        }
+    }
+    for (i = 0; i < 3; i++) {
+        if (GAME.party[i] >= 0 && GAME.party[i] < PARTNER_COUNT) {
+            coopRaidSwapBytes((u8 *)&GAME.partners[GAME.party[i]], (u8 *)&team->partners[i], sizeof(Partner));
+        }
+    }
+    if (coopRaid.shown != coopRaid.me) {
+        for (i = 0; i < 3; i++) { /* this player's back: its partners first (above), then the party */
+            k = GAME.party[i];
+            GAME.party[i] = team->party[i];
+            team->party[i] = k;
+        }
+    }
+    coopRaidSwapBytes((u8 *)FIGHTSTG_battle.fighters[0], (u8 *)coopRaid.fighters, sizeof coopRaid.fighters);
+    coopRaidSwapBytes((u8 *)BATTLE_RESULT.partners, coopRaid.result, sizeof coopRaid.result);
+    coopRaidSwapEvents(coopRaid.shown, 1 - coopRaid.shown);
+    k = FIGHTSTG_battle.active[0];
+    FIGHTSTG_battle.active[0] = coopRaid.active;
+    coopRaid.active = k;
+    coopRaid.shown = 1 - coopRaid.shown;
+}
+
+/* the battle starts: this player's party on the side, the other's whole, seat 0 first */
+static void coopRaidBegin(void) {
+    CoopRaidTeam *team = (CoopRaidTeam *)native_coop_raid()->team;
+    PartnerStats *st;
+    s32 i;
+
+    memset(&coopRaid, 0, sizeof coopRaid);
+    coopRaid.me = native_coop_raid()->first ? 0 : 1;
+    coopRaid.shown = coopRaid.me;
+    for (i = 0; i < 3; i++) {
+        if (team->party[i] < 0 || team->party[i] >= PARTNER_COUNT) {
+            continue;
+        }
+        st = &team->partners[i].info;
+        coopRaid.fighters[i].id = team->ids[i];
+        coopRaid.fighters[i].hp = coopRaid.fighters[i].maxHp = st->stats[STAT_MAX_HP];
+        coopRaid.fighters[i].mp = coopRaid.fighters[i].maxMp = st->stats[STAT_MAX_MP];
+    }
+    native_coop_note("Raid: this player is seat %d", coopRaid.me);
+}
+
+/* a player turn or the boss's came: gives out the next turn (the seats not down, then the boss), the one queued
+   dropped for it, and brings in the party it needs */
+static void coopRaidNextTurn(BattleMenu *task) {
+    s32 i;
+    s32 k = 0;
+    u32 seed;
+
+    for (i = 0; i < 99; i++) {
+        if (i != FIGHTSTG_events.curIndex &&
+            (FIGHTSTG_events.events[i].type == EVENT_PLAYER_TURN || FIGHTSTG_events.events[i].type == EVENT_ENEMY_TURN)) {
+            FIGHTSTG_events.events[i].type = 0;
+        }
+    }
+    /* a round: seat 0, seat 1, then the boss once at each (slot 2 at seat 0, 3 at seat 1); a seat down is skipped */
+    for (i = 0; i < 4; i++) {
+        k = coopRaid.turn % 4;
+        coopRaid.turn++;
+        if (!coopRaid.out[k & 1]) {
+            break;
+        }
+    }
+    coopRaid.actor = k < 2 ? k : 2;
+    coopRaid.target = k & 1;
+    if (coopRaid.actor == 2) {
+        /* the boss: its rolls from the battle and the turn, the same in both games */
+        seed = ((u32)native_coop_raid()->battle * 2654435761u) ^ ((u32)coopRaid.turn * 40503u);
+        native_coop_pvp_seed(seed);
+        coopRaid.pending = EVENT_ENEMY_TURN;
+    } else {
+        coopRaid.pending = EVENT_PLAYER_TURN;
+    }
+    if (g_coop_debug) {
+        BattleFighter *a = FIGHTSTG_battle.fighters[0];
+        BattleFighter *b = coopRaid.fighters;
+
+        native_coop_note("Raid: HP seat %d %d/%d/%d, seat %d %d/%d/%d, boss %d", coopRaid.shown, a[0].hp, a[1].hp, a[2].hp,
+                         1 - coopRaid.shown, b[0].hp, b[1].hp, b[2].hp, FIGHTSTG_battle.fighters[1][FIGHTSTG_battle.active[1]].hp);
+        native_coop_note("Raid: turn %d: %s, seat %d on", coopRaid.turn,
+                         coopRaid.actor == 2 ? "the boss" : coopRaid.actor == coopRaid.me ? "this player" : "the other",
+                         coopRaid.target);
+    }
+    if (coopRaid.target != coopRaid.shown) {
+        task->setSubstate(task, COOP_RAID_HANDOVER);
+        return;
+    }
+    coopRaid.ready = 1;
+    task->step = coopRaid.pending;
+}
+
+/* runTurn's COOP_RAID_HANDOVER: the other party in, its active fighter's entrance, then the pending turn */
+static void coopRaidHandover(BattleMenu *task, BattleMenuChildren *children) {
+    BattleFighter *unit;
+    s32 i;
+
+    switch (task->step) {
+    case 0:
+    default:
+        if (children->task.task != NULL) {
+            break;
+        }
+        WFIGHTMN_cancelBlast();
+        coopRaidSwap();
+        unit = &FIGHTSTG_battle.fighters[0][FIGHTSTG_battle.active[0]];
+        if (unit->hp == 0) { /* its active one fell before: the first standing */
+            for (i = 0; i < 3; i++) {
+                if (FIGHTSTG_battle.fighters[0][i].id != 0 && FIGHTSTG_battle.fighters[0][i].hp != 0) {
+                    FIGHTSTG_battle.active[0] = i;
+                    break;
+                }
+            }
+            unit = &FIGHTSTG_battle.fighters[0][FIGHTSTG_battle.active[0]];
+        }
+        children->task.entrance = FIGHTSTG_startEntrance(unit->id, 0, WFIGHTMN_setIdleMotion(0, 0));
+        task->step++;
+        break;
+    case 1:
+        if (children->task.entrance->done != 0) {
+            task->step++;
+        }
+        break;
+    case 2:
+        if (children->task.task == NULL) {
+            task->setSubstate(task, 1);
+            coopRaid.ready = 1;
+            task->step = coopRaid.pending;
+        }
+        break;
+    }
+}
+
+/* the other's command for its turn, kept till it's done: 1 here, 0 not yet; the other gone, its seat is down */
+static s32 coopRaidCommand(void) {
+    s32 got;
+
+    if (coopRaid.hasCommand) {
+        return 1;
+    }
+    got = native_coop_pvp_take(&coopRaid.command);
+    if (got < 0) {
+        native_coop_note("Raid: the other player left: seat %d is out", 1 - coopRaid.me);
+        coopRaid.out[1 - coopRaid.me] = 1;
+        memset(&coopRaid.command, 0, sizeof coopRaid.command);
+        coopRaid.command.action = -1;
+        coopRaid.hasCommand = 1;
+        return 1;
+    }
+    if (got > 0) {
+        s32 side;
+        s32 i;
+
+        /* the other's fighters as it had them: the boss, and the party on (its own, as here) */
+        for (side = 0; side < 2; side++) {
+            for (i = 0; i < 3; i++) {
+                if (FIGHTSTG_battle.fighters[side][i].id != 0 && FIGHTSTG_battle.fighters[side][i].hp != coopRaid.command.hp[side][i]) {
+                    native_coop_note("Raid: %s %d is HP %d here, %d there", side ? "enemy" : "partner", i,
+                                     FIGHTSTG_battle.fighters[side][i].hp, coopRaid.command.hp[side][i]);
+                }
+            }
+        }
+        coopRaid.hasCommand = 1;
+    }
+    return got > 0;
+}
+
+/* the seat whose party is on the side, for the HUD (fightstg/hud.c): -1 when no raid */
+s32 WFIGHTMN_coopRaidShown(void) {
+    return native_coop_raid() != NULL ? coopRaid.shown : -1;
+}
+
+/* A raid won: an item sure, of the boss's tier (the rare ones the enemies leave, or carry) */
+static s32 coopRaidLoot(s32 tier) {
+    static const s16 LOW[] = {0x2B, 0x2C, 0x153, 0x156, 0x159, 0x15C, 0x15F, 0x162, 0x165, 0x13C, 0x140, 0x143, 0x145};
+    static const s16 MIDDLE[] = {0x2D, 0x154, 0x157, 0x15A, 0x15D, 0x160, 0x163, 0x166, 0x2F, 0x30, 0x31, 0x32, 0x33,
+                                 0x34, 0x35, 0x151, 0x14B, 0x14D, 0x14F, 0x147, 0x149};
+    static const s16 HIGH[] = {0x2E, 0x155, 0x158, 0x15B, 0x15E, 0x161, 0x164, 0x167, 0x37, 0x38, 0x39, 0x3A, 0x3B,
+                               0x3C, 0x3D, 0x3E, 0x3F, 0x40, 0x41, 0x152, 0x14E, 0x150, 0x14C, 0x148, 0x14A, 0x144,
+                               0x146, 0x55};
+
+    if (tier >= 2) {
+        return HIGH[RANDOM.next() % (sizeof HIGH / sizeof HIGH[0])];
+    }
+    if (tier == 1) {
+        return MIDDLE[RANDOM.next() % (sizeof MIDDLE / sizeof MIDDLE[0])];
+    }
+    return LOW[RANDOM.next() % (sizeof LOW / sizeof LOW[0])];
+}
+
+/* its rolls from now on, and the command used up */
+static void coopRaidUseCommand(void) {
+    if (coopRaid.command.seed != 0) {
+        native_coop_pvp_seed(coopRaid.command.seed);
+    }
+    coopRaid.hasCommand = 0;
+}
