--- a/src/wfightmn/menu.c
+++ b/src/wfightmn/menu.c
@@ -6,6 +6,689 @@
 
 #include "wfightmn.h"
 
+#ifdef NATIVE
+/* the co-op's PvP battle (fightstg/enemy_turn.c) */
+void FIGHTSTG_coopPvpTake(const NativeCoopCommand *c);
+void FIGHTSTG_coopPvpSend(s32 action, s32 arg, s32 digimon, s32 knockOut);
+/* the PvP battle ended (its save put back): the end's last state runs every frame till the field comes, and has to go
+   on to the field, not to the report or the title */
+static s32 coopPvpEnded;
+
+/* ---- The raid (fieldstg/field.c): the players' parties (2 to 4) on this side against the boss, turn about: each
+   seat's turn in order, then the boss's once, round again: its action plays on the party shown and hits every other
+   seat's active partner too, without its animation (WFIGHTMN_coopRaidArea). The side shows one party at a time:
+   GAME's party and partners loaded with that seat's (this player's own kept whole, and put back for its turns and at
+   the end) and the fighters with them; a turn of a party not shown brings it in first (coopRaidHandover, a short
+   white flash). This
+   player's turns are picked in its menu and sent, the others' taken from their players. The boss's rolls are seeded
+   from the battle and the turn, the same in every game. ---- */
+#define COOP_RAID_HANDOVER 40 /* runTurn's substate: the party of coopRaid.target comes in */
+#define COOP_RAID_WAIT 41 /* runTurn's substate: another player's turn, its command not here yet */
+#define COOP_RAID_FLASH 10 /* the handover's white flash, in and out, in frames */
+typedef struct CoopRaidTeam { /* fieldstg/field.c's CoopTeam */
+    s32 party[3];
+    s32 ids[3];
+    Partner partners[3];
+} CoopRaidTeam;
+
+static struct {
+    s32 players;
+    s32 me;      /* this player's seat */
+    s32 shown;   /* the seat whose party is on the side */
+    s32 turn;    /* the turns given out */
+    s32 actor;   /* this turn's: a seat, or COOP_RAID_SEATS the boss */
+    s32 target;  /* the seat brought in for it */
+    s32 pending; /* the event to run once it's in */
+    s32 ready;   /* the turn is given out: runTurn runs it as it is */
+    s32 out[COOP_RAID_SEATS]; /* the seat's party is down (or its player left) */
+    s32 hasCommand;
+    NativeCoopCommand command; /* the shown seat's player's, for its turn or its pick */
+    BattleFighter fighters[COOP_RAID_SEATS][3]; /* each seat's, while off the side */
+    s32 active[COOP_RAID_SEATS];
+    QueuedEvent stash[COOP_RAID_SEATS][16]; /* each seat's events (statuses, boosts...) while off the side */
+    u8 result[COOP_RAID_SEATS][sizeof(BATTLE_RESULT.partners)]; /* each seat's who-fought, while off the side */
+    s32 myParty[3];
+    Partner myPartners[PARTNER_COUNT]; /* this player's, whole, while another party is loaded */
+    s32 waiting;    /* the seat whose command is awaited, -1 none: "Waiting for <name>..." */
+    s32 gone;       /* the seat whose player left, -1 none: "<name> disconnected." */
+    s32 goneFrames; /* how long that stays */
+    s32 goneFled;   /* it ran away: "<name> ran away." */
+    s16 gauges[COOP_RAID_SEATS][8]; /* each seat's BATTLE_SETUP.gauges (by party member), while off the side */
+    s32 bannerFrames; /* "Turn: <name>" / "Your turn!" / "Turn: <boss>" for coopRaid.actor, how long it stays */
+    s32 handFile;     /* the handover's model file */
+} coopRaid;
+
+static s32 coopRaidCommandOf(s32 seat);
+static void coopRaidUseCommand(void);
+
+/* the events of a party's fighters (by their slot): kept apart while the party is off the side */
+static s32 coopRaidPartyEvent(QueuedEvent *e) {
+    switch (e->type) {
+    case EVENT_AUTO_RECOVER_END:
+    case EVENT_RECOVERY:
+    case EVENT_PARTNER_TECH:
+    case EVENT_STATUS_DAMAGE:
+    case EVENT_STATUS_END:
+    case EVENT_STATUS_END + 1:
+    case EVENT_STATUS_END + 2:
+    case EVENT_BOOST_END:
+    case EVENT_BOOST_END + 1:
+    case EVENT_BOOST_END + 2:
+    case EVENT_RESTRICTION_END:
+    case EVENT_RESTRICTION_END + 1:
+    case EVENT_BLAST_END:
+    case EVENT_SPECIAL_END:
+    case EVENT_DIGIDEVOLVE:
+        return e->args[0] == 0;
+    default:
+        return 0;
+    }
+}
+
+/* the turn is a party's not this player's: its player's command, not this side's menu */
+static s32 coopRaidRemote(void) {
+    return native_coop_raid() != NULL && coopRaid.shown != coopRaid.me;
+}
+
+/* another seat than the shown one still standing */
+static s32 coopRaidOthersStanding(void) {
+    s32 i;
+
+    for (i = 0; i < coopRaid.players; i++) {
+        if (i != coopRaid.shown && !coopRaid.out[i]) {
+            return 1;
+        }
+    }
+    return 0;
+}
+
+/* seat's party on the side: the shown one's kept (its party and partners, fighters, who-fought, events), seat's loaded */
+static void coopRaidShow(s32 seat) {
+    NativeCoopPvp *raid = native_coop_raid();
+    CoopRaidTeam *team;
+    s32 from = coopRaid.shown;
+    s32 i;
+    s32 k;
+
+    if (seat == from) {
+        return;
+    }
+    /* keep the shown one's */
+    if (from == coopRaid.me) {
+        memcpy(coopRaid.myParty, GAME.party, sizeof coopRaid.myParty);
+        memcpy(coopRaid.myPartners, GAME.partners, sizeof coopRaid.myPartners);
+    } else {
+        team = (CoopRaidTeam *)raid->teams[from];
+        for (i = 0; i < 3; i++) {
+            team->party[i] = GAME.party[i];
+            if (GAME.party[i] >= 0 && GAME.party[i] < PARTNER_COUNT) {
+                team->partners[i] = GAME.partners[GAME.party[i]];
+            }
+        }
+    }
+    memcpy(coopRaid.fighters[from], FIGHTSTG_battle.fighters[0], sizeof coopRaid.fighters[from]);
+    coopRaid.active[from] = FIGHTSTG_battle.active[0];
+    memcpy(coopRaid.result[from], BATTLE_RESULT.partners, sizeof coopRaid.result[from]);
+    memcpy(coopRaid.gauges[from], BATTLE_SETUP.gauges, sizeof coopRaid.gauges[from]);
+    memset(coopRaid.stash[from], 0, sizeof coopRaid.stash[from]);
+    for (i = 0, k = 0; i < 99; i++) {
+        if (coopRaidPartyEvent(&FIGHTSTG_events.events[i]) && k < 16) {
+            coopRaid.stash[from][k++] = FIGHTSTG_events.events[i];
+            FIGHTSTG_events.events[i].type = 0;
+        }
+    }
+    /* load seat's */
+    if (seat == coopRaid.me) {
+        memcpy(GAME.party, coopRaid.myParty, sizeof coopRaid.myParty);
+        memcpy(GAME.partners, coopRaid.myPartners, sizeof coopRaid.myPartners);
+    } else {
+        team = (CoopRaidTeam *)raid->teams[seat];
+        for (i = 0; i < 3; i++) {
+            GAME.party[i] = team->party[i];
+            if (team->party[i] >= 0 && team->party[i] < PARTNER_COUNT) {
+                GAME.partners[team->party[i]] = team->partners[i];
+            }
+        }
+    }
+    memcpy(FIGHTSTG_battle.fighters[0], coopRaid.fighters[seat], sizeof coopRaid.fighters[seat]);
+    FIGHTSTG_battle.active[0] = coopRaid.active[seat];
+    memcpy(BATTLE_RESULT.partners, coopRaid.result[seat], sizeof coopRaid.result[seat]);
+    memcpy(BATTLE_SETUP.gauges, coopRaid.gauges[seat], sizeof coopRaid.gauges[seat]);
+    for (k = 0, i = 0; k < 16 && coopRaid.stash[seat][k].type != 0; k++) {
+        while (i < 99 && FIGHTSTG_events.events[i].type != 0) {
+            i++;
+        }
+        if (i == 99) {
+            break;
+        }
+        FIGHTSTG_events.events[i] = coopRaid.stash[seat][k];
+    }
+    memset(coopRaid.stash[seat], 0, sizeof coopRaid.stash[seat]);
+    coopRaid.shown = seat;
+}
+
+/* the battle starts: this player's party on the side, the others' whole, seat 0 first */
+static void coopRaidBegin(void) {
+    NativeCoopPvp *raid = native_coop_raid();
+    CoopRaidTeam *team;
+    PartnerStats *st;
+    s32 s;
+    s32 i;
+
+    memset(&coopRaid, 0, sizeof coopRaid);
+    coopRaid.players = raid->players;
+    coopRaid.me = raid->me;
+    coopRaid.waiting = coopRaid.gone = -1;
+
+    coopRaid.shown = coopRaid.me;
+    for (s = 0; s < coopRaid.players; s++) {
+        if (s == coopRaid.me) {
+            continue;
+        }
+        team = (CoopRaidTeam *)raid->teams[s];
+        for (i = 0; i < 3; i++) {
+            if (team->party[i] < 0 || team->party[i] >= PARTNER_COUNT) {
+                continue;
+            }
+            st = &team->partners[i].info;
+            coopRaid.fighters[s][i].id = team->ids[i];
+            coopRaid.fighters[s][i].hp = coopRaid.fighters[s][i].maxHp = st->stats[STAT_MAX_HP];
+            coopRaid.fighters[s][i].mp = coopRaid.fighters[s][i].maxMp = st->stats[STAT_MAX_MP];
+        }
+    }
+    native_coop_note("Raid: %d players, this one is seat %d", coopRaid.players, coopRaid.me);
+}
+
+/* the first seat standing from seat on, -1 none */
+static s32 coopRaidStanding(s32 seat) {
+    s32 i;
+
+    for (i = 0; i < coopRaid.players; i++) {
+        if (!coopRaid.out[(seat + i) % coopRaid.players]) {
+            return (seat + i) % coopRaid.players;
+        }
+    }
+    return -1;
+}
+
+/* a player turn or the boss's came: gives out the next turn (the seats standing in order, then the boss once, at the
+   party shown), the one queued dropped for it, and brings in the party it needs */
+static void coopRaidNextTurn(BattleMenu *task) {
+    s32 n = coopRaid.players + 1;
+    s32 i;
+    s32 k = 0;
+    u32 seed;
+
+    for (i = 0; i < 99; i++) {
+        if (i != FIGHTSTG_events.curIndex &&
+            (FIGHTSTG_events.events[i].type == EVENT_PLAYER_TURN || FIGHTSTG_events.events[i].type == EVENT_ENEMY_TURN)) {
+            FIGHTSTG_events.events[i].type = 0;
+        }
+    }
+    if (coopRaidStanding(0) < 0) {
+        /* no one left (down, gone or run away): lost */
+        native_coop_note("Raid: no seat standing");
+        FIGHTSTG_endBattle(BATTLE_LOST);
+        task->setSubstate(task, 0);
+        return;
+    }
+    /* a round: each seat, then the boss (k == players); a seat down is skipped */
+    for (i = 0; i < n; i++) {
+        k = coopRaid.turn % n;
+        coopRaid.turn++;
+        if (k == coopRaid.players || !coopRaid.out[k]) {
+            break;
+        }
+    }
+    coopRaid.target = k;
+    coopRaid.bannerFrames = 90;
+    if (k >= coopRaid.players) {
+        /* the boss: its rolls from the battle and the turn, the same in every game; it acts on the party shown */
+        coopRaid.target = coopRaidStanding(coopRaid.shown);
+        coopRaid.actor = COOP_RAID_SEATS;
+        seed = ((u32)native_coop_raid()->battle * 2654435761u) ^ ((u32)coopRaid.turn * 40503u);
+        native_coop_pvp_seed(seed);
+        coopRaid.pending = EVENT_ENEMY_TURN;
+    } else {
+        coopRaid.actor = k;
+        coopRaid.pending = EVENT_PLAYER_TURN;
+    }
+    if (g_coop_debug) {
+        native_coop_note("Raid: turn %d: %s, seat %d on; HP %d/%d/%d, boss %d", coopRaid.turn,
+                         coopRaid.actor == COOP_RAID_SEATS ? "the boss" : coopRaid.actor == coopRaid.me ? "this player" : "another",
+                         coopRaid.target, FIGHTSTG_battle.fighters[0][0].hp, FIGHTSTG_battle.fighters[0][1].hp,
+                         FIGHTSTG_battle.fighters[0][2].hp, FIGHTSTG_battle.fighters[1][FIGHTSTG_battle.active[1]].hp);
+    }
+    if (coopRaid.actor < COOP_RAID_SEATS && coopRaid.actor != coopRaid.me) {
+        task->setSubstate(task, COOP_RAID_WAIT); /* its command first: its party only comes in with it */
+        return;
+    }
+    if (coopRaid.target != coopRaid.shown) {
+        task->setSubstate(task, COOP_RAID_HANDOVER);
+        return;
+    }
+    coopRaid.ready = 1;
+    task->step = coopRaid.pending;
+}
+
+/* runTurn's COOP_RAID_WAIT: another player's command came: its party in and its turn; it left: the next turn */
+static void coopRaidWait(BattleMenu *task) {
+    if (!coopRaidCommandOf(coopRaid.actor)) {
+        return;
+    }
+    if (coopRaid.command.action == 1 && !coopRaid.out[coopRaid.actor]) {
+        /* it ran away: out of the battle alone, as if gone (its game goes back to the field) */
+        native_coop_note("Raid: seat %d ran away: its party is out", coopRaid.actor);
+        coopRaid.out[coopRaid.actor] = 1;
+        coopRaid.gone = coopRaid.actor;
+        coopRaid.goneFled = 1;
+        coopRaid.goneFrames = 60 * 3;
+        coopRaidUseCommand();
+    }
+    if (coopRaid.out[coopRaid.actor]) {
+        coopRaid.hasCommand = 0;
+        task->setSubstate(task, 1);
+        coopRaid.ready = 0;
+        task->step = EVENT_PLAYER_TURN; /* given out again: the next seat's */
+        return;
+    }
+    if (coopRaid.target != coopRaid.shown) {
+        task->setSubstate(task, COOP_RAID_HANDOVER);
+        return;
+    }
+    task->setSubstate(task, 1);
+    coopRaid.ready = 1;
+    task->step = coopRaid.pending;
+}
+
+/* runTurn's COOP_RAID_HANDOVER: the target's party in behind a short white flash (its active fighter's model changed
+   while the screen is white, no entrance), then the pending turn */
+static void coopRaidHandover(BattleMenu *task, BattleMenuChildren *children) {
+    BattleFighter *unit;
+    ModelControl *control;
+    Models *models = children->models;
+    s32 weak;
+    s32 i;
+
+    switch (task->step) {
+    case 0:
+    default:
+        if (children->task.task != NULL) {
+            break;
+        }
+        WFIGHTMN_cancelBlast();
+        coopRaidShow(coopRaid.target);
+        unit = &FIGHTSTG_battle.fighters[0][FIGHTSTG_battle.active[0]];
+        if (unit->hp == 0) { /* its active one fell before: the first standing */
+            for (i = 0; i < 3; i++) {
+                if (FIGHTSTG_battle.fighters[0][i].id != 0 && FIGHTSTG_battle.fighters[0][i].hp != 0) {
+                    FIGHTSTG_battle.active[0] = i;
+                    break;
+                }
+            }
+            unit = &FIGHTSTG_battle.fighters[0][FIGHTSTG_battle.active[0]];
+        }
+        coopRaid.handFile = FIGHTSTG_fighterCache.funcs.getInfo(unit->id)->model >> 16;
+        FILE_CACHE.request(coopRaid.handFile);
+        children->task.task = (Task *)FIGHTSTG_startWhiteFlash(COOP_RAID_FLASH);
+        task->step++;
+        break;
+    case 1:
+        if (FILE_CACHE.isLoading(coopRaid.handFile) != 0 || children->task.task == NULL ||
+            ((WhiteFlash *)children->task.task)->substate == 0) {
+            break; /* the model still loading, or the screen not white yet */
+        }
+        unit = &FIGHTSTG_battle.fighters[0][FIGHTSTG_battle.active[0]];
+        weak = WFIGHTMN_setIdleMotion(0, 0);
+        models->add(models, 1, unit->id, 0);
+        models->setId(models, 1, 0);
+        models->face(models, 0);
+        control = models->get(models, 0);
+        control->layers[0].layerId = BATTLE_LAYER_MODELS;
+        control->layers[0].enabled = 1;
+        control->layers[0].wireframe = 0;
+        control->motion = weak != 0 ? 2 : 1;
+        FIGHTSTG_endWhiteFlash((WhiteFlash *)children->task.task, COOP_RAID_FLASH);
+        task->step++;
+        break;
+    case 2:
+        if (children->task.task == NULL) {
+            task->setSubstate(task, 1);
+            coopRaid.ready = 1;
+            task->step = coopRaid.pending;
+        }
+        break;
+    }
+}
+
+/* the shown seat's player's command (its turn, or its pick), kept till it's used: 1 here, 0 not yet; the player gone,
+   its seat is down */
+static s32 coopRaidCommandOf(s32 seat) {
+    s32 got;
+    s32 side;
+    s32 i;
+
+    if (coopRaid.hasCommand) {
+        coopRaid.waiting = -1;
+        return 1;
+    }
+    coopRaid.waiting = seat;
+    got = native_coop_raid_take(seat, &coopRaid.command);
+    if (got < 0) {
+        native_coop_note("Raid: seat %d's player left: its party is out", seat);
+        coopRaid.out[seat] = 1;
+        coopRaid.gone = seat;
+        coopRaid.goneFled = 0;
+        coopRaid.goneFrames = 60 * 4;
+        coopRaid.waiting = -1;
+        memset(&coopRaid.command, 0, sizeof coopRaid.command);
+        coopRaid.command.action = -1;
+        coopRaid.hasCommand = 1;
+        return 1;
+    }
+    if (got == 0) {
+        return 0;
+    }
+    coopRaid.waiting = -1;
+    /* its fighters as it had them: the boss, and the party on (its own, as here: once it's on) */
+    for (side = seat == coopRaid.shown ? 0 : 1; side < 2; side++) {
+        for (i = 0; i < 3; i++) {
+            if (FIGHTSTG_battle.fighters[side][i].id != 0 && FIGHTSTG_battle.fighters[side][i].hp != coopRaid.command.hp[side][i]) {
+                native_coop_note("Raid: %s %d is HP %d here, %d there", side ? "enemy" : "partner", i,
+                                 FIGHTSTG_battle.fighters[side][i].hp, coopRaid.command.hp[side][i]);
+            }
+        }
+    }
+    coopRaid.hasCommand = 1;
+    return 1;
+}
+
+static s32 coopRaidCommand(void) {
+    return coopRaidCommandOf(coopRaid.shown);
+}
+
+/* ---- The raid's lines over the battle: "Waiting for <name>..." while a player's command is awaited, "<name>
+   disconnected." a while once one left ---- */
+static void coopRaidRect(s32 x, s32 y, s32 w, s32 h, s32 r, s32 g, s32 b, s32 half) {
+    Layer *layer = GFX.funcs.getLayer(BATTLE_LAYER_MENUS);
+    u_long *ot = (u_long *)layer->getOtEntry(layer, 1);
+    POLY_F4 *poly = GFX.funcs.getPrim();
+    DR_TPAGE *mode;
+
+    setPolyF4(poly);
+    setRGB0(poly, r, g, b);
+    setXY4(poly, x, y, x + w, y, x, y + h, x + w, y + h);
+    if (half) {
+        setSemiTrans(poly, 1);
+    }
+    addPrim(ot, poly);
+    mode = (DR_TPAGE *)(poly + 1);
+    if (half) { /* the ground under it darkened (subtracted) */
+        SetDrawTPage(mode, 0, 1, GetTPage(0, 2, 0, 0));
+        addPrim(ot, mode);
+        mode++;
+    }
+    GFX.funcs.setPrim(mode);
+}
+
+/* The game's text (0-ended) at x, y in the palette: its width */
+static s32 coopRaidText(const u8 *text, s32 x, s32 y, s32 palette) {
+    Layer *layer = GFX.funcs.getLayer(BATTLE_LAYER_MENUS);
+    u_long *ot = (u_long *)layer->getOtEntry(layer, 0);
+    TextStyle *style = &FONT.styles[1];
+    const u8 *p = text;
+    PrimPtr prim;
+    Glyph *g;
+    s32 c;
+    s32 kind;
+    s32 cx = 0;
+    s32 tpage;
+
+    prim.any = GFX.funcs.getPrim();
+    for (;;) {
+        c = FONT.decode(p, 0, style);
+        kind = (c >> 8) & 0xFF;
+        if (kind == 4 || *p == 0) {
+            break;
+        }
+        if (kind == 0) {
+            g = &style->glyphs[(c & 0xFF) - 4];
+            p += 1;
+        } else if (kind == 1) {
+            g = (c & 0xFF) > 0 && (c & 0xFF) <= style->iconCount ? &style->icons[(c & 0xFF) - 1] : style->glyphs;
+            p += 2;
+        } else if (kind == 2) {
+            p += p[1] < 11 && FONT.codeLengths[p[1]] > 0 ? FONT.codeLengths[p[1]] : 2;
+            cx += 4;
+            continue;
+        } else {
+            g = style->glyphs;
+            p += 1;
+        }
+        if (g->page == 0xFF) {
+            g = style->glyphs;
+        }
+        tpage = getTPage(0, style->blend == 0xFF ? 1 : style->blend & 3, 0x140 + (g->page << 6), 0);
+        setlen(prim.sprt, 4);
+        setcode(prim.sprt, 0x64);
+        if (style->blend != 0xFF) {
+            setSemiTrans(prim.sprt, 1);
+        }
+        prim.sprt->r0 = prim.sprt->g0 = prim.sprt->b0 = 0x80;
+        prim.sprt->x0 = x + cx + g->dx;
+        prim.sprt->y0 = y + g->dy;
+        prim.sprt->u0 = g->u;
+        prim.sprt->v0 = g->v;
+        prim.sprt->w = g->w;
+        prim.sprt->h = g->h;
+        prim.sprt->clut = getClut(0x140 + g->clutX, palette + g->clutY);
+        addPrim(ot, prim.any);
+        prim.sprt++;
+        SetDrawTPage(prim.tpage, 0, 1, tpage);
+        addPrim(ot, prim.any);
+        prim.tpage++;
+        cx += g->advance;
+    }
+    GFX.funcs.setPrim(prim.any);
+    return cx;
+}
+
+static const u8 *coopRaidString(s32 n) {
+    return (const u8 *)getString((s32 *)native_coop_text(LANGUAGE), n); /* n: a COOP_TEXT_RAID_* */
+}
+
+/* a seat's player's name (the game's text): its own the save's */
+static void coopRaidName(s32 seat, u8 *out, s32 size) {
+    const u8 *name = native_coop_raid()->names[seat]; /* fieldstg/field.c's, from the field */
+    s32 i = 0;
+
+    while (i < size - 1 && i < 15 && name[i] != 0) {
+        out[i] = name[i];
+        i++;
+    }
+    out[i] = 0;
+}
+
+
+/* the line, in its box over the battle: a + b + c (the game's text), what it is, -1 none */
+static void coopRaidLine(const u8 *a, const u8 *b, const u8 *c) {
+    s32 w;
+
+    /* drawn once to measure (off the screen), then centred in its box */
+    w = coopRaidText(a, -400, -40, PALETTE_WHITE);
+    w += coopRaidText(b, -400, -40, PALETTE_WHITE);
+    w += coopRaidText(c, -400, -40, PALETTE_WHITE);
+    coopRaidRect(160 - w / 2 - 8, 0x50, w + 16, 1, 0xF0, 0xB0, 0x20, 0);
+    coopRaidRect(160 - w / 2 - 8, 0x50 + 17, w + 16, 1, 0xF0, 0xB0, 0x20, 0);
+    coopRaidRect(160 - w / 2 - 8, 0x50, 1, 18, 0xF0, 0xB0, 0x20, 0);
+    coopRaidRect(160 + (w + 1) / 2 + 7, 0x50, 1, 18, 0xF0, 0xB0, 0x20, 0);
+    coopRaidRect(160 - w / 2 - 7, 0x51, w + 14, 16, 0x68, 0x68, 0x58, 1);
+    w = 160 - w / 2;
+    w += coopRaidText(a, w, 0x53, PALETTE_WHITE);
+    w += coopRaidText(b, w, 0x53, PALETTE_WHITE); /* the battle has the white palette only: the others draw wrong */
+    coopRaidText(c, w, 0x53, PALETTE_WHITE);
+}
+
+/* every frame of the raid's battle */
+static void coopRaidLines(void) {
+    BattleTableEntry *boss;
+    u8 name[24];
+
+    if (coopRaid.goneFrames > 0) {
+        coopRaid.goneFrames--;
+        coopRaidName(coopRaid.gone, name, sizeof name);
+        coopRaidLine((const u8 *)"", name, coopRaidString(coopRaid.goneFled ? COOP_TEXT_RAID_FLED : COOP_TEXT_RAID_GONE));
+    } else if (coopRaid.waiting >= 0 && coopRaid.waiting != coopRaid.me) {
+        coopRaidName(coopRaid.waiting, name, sizeof name);
+        coopRaidLine(coopRaidString(COOP_TEXT_RAID_WAITING), name, coopRaidString(COOP_TEXT_RAID_DOTS)); /* "Waiting for " <name> "..." */
+    } else if (coopRaid.bannerFrames > 0) {
+        coopRaid.bannerFrames--;
+        if (coopRaid.actor == coopRaid.me) {
+            coopRaidLine((const u8 *)"", coopRaidString(COOP_TEXT_RAID_YOUR_TURN), (const u8 *)"");
+        } else if (coopRaid.actor < COOP_RAID_SEATS) {
+            coopRaidName(coopRaid.actor, name, sizeof name);
+            coopRaidLine(coopRaidString(COOP_TEXT_RAID_TURN), name, (const u8 *)""); /* "Turn: " <name> */
+        } else {
+            boss = FIGHTSTG_battleTableFunc(FIGHTSTG_battle.fighters[1][FIGHTSTG_battle.active[1]].id);
+            coopRaidLine(coopRaidString(COOP_TEXT_RAID_TURN),
+                         (const u8 *)getString((s32 *)FILE_CACHE.load(TEXT_FILE(TEXT_DIGIMON_NAMES)), boss->nameId),
+                         (const u8 *)"");
+        }
+    }
+}
+
+/* the seat whose party is on the side, for the HUD (fightstg/hud.c): -1 when no raid */
+/* the boss's action in a raid (fightstg/enemy_turn.c, before it plays on the party shown): the same technique hits
+   every other seat's active partner standing too, rolled and taken here without its animation (its damage, a knockout,
+   poison, paralysis, confusion, sleep, a lowered stat, drained MP); the techniques that aren't a hit (on the boss
+   itself, a switch...) only play once. A seat with no one standing after it is out. The same in every game: the rolls
+   are the shared ones, in the seats' order */
+void WFIGHTMN_coopRaidArea(s32 tech) {
+    TechData *entry = &TECHS[tech - 1];
+    BattleFighter *unit;
+    s32 shown = coopRaid.shown;
+    s32 before;
+    s32 damage;
+    s32 s;
+    s32 i;
+
+    if (native_coop_raid() == NULL || (entry->icon != TECH_PHYSICAL && entry->icon != TECH_MAGIC)) {
+        return;
+    }
+    switch (entry->effect) {
+    case 0:
+    case 1:
+    case TECH_EFFECT_POISON:
+    case TECH_EFFECT_PARALYSIS:
+    case TECH_EFFECT_CONFUSION:
+    case TECH_EFFECT_SLEEP:
+    case TECH_EFFECT_KNOCK_OUT:
+    case TECH_EFFECT_DRAIN:
+    case TECH_EFFECT_MULTI_HIT:
+    case TECH_EFFECT_CRITICAL:
+    case TECH_EFFECT_LOWER_ATTACK:
+    case TECH_EFFECT_LOWER_DEFENSE:
+    case TECH_EFFECT_DRAIN_MP:
+        break;
+    default:
+        return;
+    }
+    for (s = 0; s < coopRaid.players; s++) {
+        if (s == shown || coopRaid.out[s]) {
+            continue;
+        }
+        coopRaidShow(s);
+        unit = &FIGHTSTG_battle.fighters[0][FIGHTSTG_battle.active[0]];
+        if (unit->hp == 0) { /* its active one fell: the first standing takes it (its handover does the same) */
+            for (i = 0; i < 3; i++) {
+                if (FIGHTSTG_battle.fighters[0][i].id != 0 && FIGHTSTG_battle.fighters[0][i].hp != 0) {
+                    FIGHTSTG_battle.active[0] = i;
+                    break;
+                }
+            }
+            unit = &FIGHTSTG_battle.fighters[0][FIGHTSTG_battle.active[0]];
+        }
+        if (unit->hp == 0) {
+            coopRaid.out[s] = 1;
+            continue;
+        }
+        before = unit->hp;
+        FIGHTSTG_startAction(SIDE_ENEMY, tech);
+        if (FIGHTSTG_action.effects[TECH_EFFECT_KNOCK_OUT]) {
+            unit->hp = 0;
+        } else if (FIGHTSTG_action.hits[0]) {
+            damage = FIGHTSTG_action.effects[TECH_EFFECT_MULTI_HIT] ? FIGHTSTG_action.hitsLanded * FIGHTSTG_action.damage
+                                                                   : FIGHTSTG_action.damage;
+            if (damage > 9999) {
+                damage = 9999;
+            }
+            unit->hp = unit->hp > damage ? unit->hp - damage : 0;
+            if (FIGHTSTG_action.effects[TECH_EFFECT_DRAIN_MP]) {
+                unit->mp = unit->mp > FIGHTSTG_action.drain ? unit->mp - FIGHTSTG_action.drain : 0;
+            }
+            if (unit->hp != 0) {
+                if (FIGHTSTG_action.effects[TECH_EFFECT_POISON]) {
+                    FIGHTSTG_inflictPoison(0, FIGHTSTG_battle.active[0], FIGHTSTG_action.effects[TECH_EFFECT_POISON]);
+                }
+                if (FIGHTSTG_action.effects[TECH_EFFECT_PARALYSIS]) {
+                    FIGHTSTG_inflictParalysis(0, tech, FIGHTSTG_action.effects[TECH_EFFECT_PARALYSIS]);
+                }
+                if (FIGHTSTG_action.effects[TECH_EFFECT_CONFUSION]) {
+                    FIGHTSTG_inflictConfusion(0, tech, FIGHTSTG_action.effects[TECH_EFFECT_CONFUSION]);
+                }
+                if (FIGHTSTG_action.effects[TECH_EFFECT_SLEEP]) {
+                    FIGHTSTG_inflictSleep(0, tech, FIGHTSTG_action.effects[TECH_EFFECT_SLEEP]);
+                }
+            }
+        }
+        native_coop_note("Raid: the boss's technique %d hits seat %d too: HP %d -> %d", tech, s, before, unit->hp);
+        for (i = 0; i < 3 && (FIGHTSTG_battle.fighters[0][i].id == 0 || FIGHTSTG_battle.fighters[0][i].hp == 0); i++) {
+        }
+        if (i == 3) {
+            native_coop_note("Raid: seat %d is down", s);
+            coopRaid.out[s] = 1;
+        }
+    }
+    coopRaidShow(shown);
+    HEAP.zero(&FIGHTSTG_action, BATTLE_ACTION_STATE_SIZE);
+}
